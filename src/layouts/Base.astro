---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
// Preload the Latin font files used above the fold to avoid layout shift when fonts swap in.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActions from '../components/MobileActions.astro';
import { business } from '../data/business';
import { restaurantSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/menu". Used for the canonical URL. */
  path: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/og-image.jpg',
  ogImageAlt = `${business.name} — Cajun seafood boil`,
  schema = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
// Pages are served without a trailing slash (see astro.config.mjs / vercel.json).
const canonical = new URL(path === '/' ? '/' : path.replace(/\/+$/, ''), site).href;
const ogImageUrl = new URL(ogImage, site).href;
const jsonLd = [restaurantSchema(site), ...schema];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalicUrl} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#061423" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileActions />
  </body>
</html>
