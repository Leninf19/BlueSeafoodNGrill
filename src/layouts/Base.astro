---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/big-shoulders-display';
import '../styles/global.css';
// Preload the Latin font files used above the fold to avoid layout shift when fonts swap in.
import serifUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import serifItalicUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url';
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActions from '../components/MobileActions.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { business } from '../data/business';
import { restaurantSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/menu". Used for the canonical URL. */
  path: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Pixel size of ogImage when it is not the default 1200×630 share image. */
  ogImageSize?: { width: number; height: number };
  /** Extra JSON-LD objects for this page. */
  schema?: object[];
  noindex?: boolean;
  /** Page opens with a full-bleed photo: header starts transparent over it. */
  headerOverlay?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/og-image.jpg',
  ogImageAlt = `${business.name} — Cajun seafood boil`,
  ogImageSize = { width: 1200, height: 630 },
  schema = [],
  noindex = false,
  headerOverlay = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
// Pages are served without a trailing slash (see astro.config.mjs / vercel.json).
const canonical = new URL(path === '/' ? '/' : path.replace(/\/+$/, ''), site).href;
const ogImageUrl = new URL(ogImage, site).href;
const jsonLd = [restaurantSchema(site), ...schema];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Non-indexed pages (the 404) get no canonical: their URL is whatever was mistyped. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />
    <noscript><style>[data-header][data-at-top] { background: #0b2236 !important; }</style></noscript>

    <meta name="theme-color" content="#0b2236" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    {/* First in <body>, not <head>: Astro injects the CSP meta tag after the head content, and the tag must come after it. */}
    <GoogleAnalytics />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={headerOverlay} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileActions />
  </body>
</html>
