---
/**
 * Frequently asked questions. Every answer uses facts already verified elsewhere on the site
 * (Google Business Profile, menu data, ordering and reservation pages). Do not add answers
 * about parking, seating, alcohol, catering or allergens until the restaurant confirms them.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business, fullAddress } from '../data/business';
import { consumerAdvisory } from '../data/menu';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const site = Astro.site ?? new URL(Astro.url.origin);
const trail = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq' },
];

const groups: { title: string; items: { q: string; a: string; link?: { href: string; label: string } }[] }[] = [
  {
    title: 'Visiting',
    items: [
      {
        q: 'What are Blue Seafood & Grill’s hours?',
        a: 'Tuesday through Thursday 11:30 AM – 8:00 PM, and Friday through Sunday 11:30 AM – 8:30 PM. Closed Mondays.',
        link: { href: '/visit', label: 'Hours and directions' },
      },
      {
        q: 'Where is Blue Seafood & Grill?',
        a: `${fullAddress}, on East Grand Avenue.`,
        link: { href: '/visit', label: 'Map and directions' },
      },
      {
        q: 'Do you take reservations?',
        a: `Yes. Book online through Reserve with Google (booking times are provided by Yelp), or call ${business.phone.display}.`,
        link: { href: '/reservations', label: 'Reservations' },
      },
      {
        q: 'Can you seat a large group?',
        a: `For larger parties, please call ${business.phone.display} ahead of time so we can check availability.`,
      },
      {
        q: 'Do you have daily specials?',
        a: `Ask our team what’s available today when you visit, or call ${business.phone.display}.`,
      },
    ],
  },
  {
    title: 'Ordering',
    items: [
      {
        q: 'Can I order online for pickup or delivery?',
        a: 'Yes. Blue takes online orders for pickup and delivery through DoorDash, and on Blue’s order.online page (powered by DoorDash).',
        link: { href: '/order', label: 'Pickup and delivery' },
      },
      {
        q: 'Why don’t you list prices on the website?',
        a: `Dishes and prices can change, so we don’t post them here. For current pricing, call ${business.phone.display}; prices for online orders are shown on DoorDash.`,
      },
    ],
  },
  {
    title: 'The menu',
    items: [
      {
        q: 'What kind of food does Blue Seafood & Grill serve?',
        a: 'Mostly seafood — oysters, starters like crab cakes and calamari, Cajun seafood boil, pan roast and cioppino, tacos, a lobster roll, fish n’ chips, seafood pastas, salmon and halibut — plus a bone-in ribeye and a Western burger.',
        link: { href: '/menu', label: 'See the menu' },
      },
      {
        q: 'How are the oysters served?',
        a: 'The menu lists three ways — baked Rockefeller-style, grilled with garlic butter, or fried — each by the half dozen or dozen.',
        link: { href: '/menu/oysters', label: 'Oysters' },
      },
      {
        q: 'What’s in the Cajun Seafood Boil?',
        a: 'Shrimp, crab, lobster, clams, mussels, red potatoes, corn and smoked sausage in spicy garlic butter.',
        link: { href: '/menu/cajun-seafood-boil', label: 'Cajun Seafood Boil' },
      },
      {
        q: 'Do you serve steak?',
        a: 'Yes — a bone-in ribeye with pomme purée, grilled asparagus and peppercorn sauce, and a Western burger.',
        link: { href: '/menu/bone-in-ribeye', label: 'Bone-In Ribeye' },
      },
      {
        q: 'Do you have vegetarian or vegan dishes?',
        a: 'Yes. The menu includes Veggie Marinara Bucatini (vegetarian) and Shiitake Tacos (vegan), along with salads. Let your server know about any dietary needs.',
      },
      {
        q: 'Is there a kids menu?',
        a: 'Yes: kids sliders, kids pasta with butter or marinara, and kids fish n’ chips.',
      },
      {
        q: 'Are any dishes served raw?',
        a: `The Shrimp Ceviche Tostadas and the Sesame-Seared Ahi Tuna are marked raw or undercooked on the menu. ${consumerAdvisory}`,
      },
      {
        q: 'Can you accommodate food allergies?',
        a: 'Please tell your server about any food allergies before you order.',
      },
    ],
  },
  {
    title: 'Contact',
    items: [
      {
        q: 'How can I contact Blue Seafood & Grill?',
        a: `Call ${business.phone.display}. Blue is also on Instagram (${business.links.instagramHandle}) and Facebook.`,
      },
    ],
  },
];

const allFaqs = groups.flatMap((g) => g.items.map(({ q, a }) => ({ q, a })));
---

<Base
  title="FAQ – Hours, Reservations, Ordering & Menu | Blue Seafood & Grill"
  description="Answers about Blue Seafood & Grill in Arroyo Grande: hours, location, reservations, pickup and delivery, oysters, the seafood boil, steak and vegetarian dishes."
  path="/faq"
  schema={[breadcrumbSchema(site, trail), faqSchema(allFaqs)]}
>
  <section class="info-top bg-glass">
    <div class="container info-top-inner">
      <Breadcrumbs trail={trail} />
      <p class="label">Good to know</p>
      <h1 class="display-xl">Frequently asked <em>questions</em></h1>
      <p class="lede">Hours, reservations, ordering and the menu at Blue Seafood &amp; Grill in Arroyo Grande.</p>
    </div>
  </section>

  <div class="container-narrow faq-page">
    {
      groups.map((g) => (
        <section class="faq-group" aria-labelledby={`faq-${g.title.toLowerCase().replace(/\s+/g, '-')}`}>
          <h2 id={`faq-${g.title.toLowerCase().replace(/\s+/g, '-')}`} class="display-sm">{g.title}</h2>
          <div class="faq-list">
            {g.items.map((f) => (
              <details class="faq">
                <summary>
                  <span>{f.q}</span>
                  <span class="faq-icon" aria-hidden="true" />
                </summary>
                <div class="faq-answer">
                  <p>{f.a}</p>
                  {f.link && (
                    <a class="text-link" href={f.link.href}>
                      {f.link.label} <Icon name="arrowRight" size={15} />
                    </a>
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }
    <p class="faq-foot">
      Still have a question? Call <a class="text-link" href={business.phone.href}>{business.phone.display}</a>.
    </p>
  </div>
</Base>

<style>
  .faq-page {
    display: grid;
    gap: 2.75rem;
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .faq-group {
    display: grid;
    gap: 1rem;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    list-style: none;
    cursor: pointer;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -1px;
    background: var(--blue);
    transition: transform 0.2s var(--ease);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }

  .faq-answer {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding-bottom: 1.2rem;
    color: var(--soft);
  }

  .faq-foot {
    color: var(--soft);
  }
</style>
