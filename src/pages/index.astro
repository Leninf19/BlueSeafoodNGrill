---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import Reviews from '../components/Reviews.astro';
import WaveRule from '../components/WaveRule.astro';
import { business, fullAddress } from '../data/business';
import { menu, type MenuItem } from '../data/menu';
import type { PhotoKey } from '../data/photos';

const findItem = (name: string): MenuItem => {
  const item = menu.flatMap((s) => s.items).find((i) => i.name === name);
  if (!item) throw new Error(`Featured dish "${name}" is not in src/data/menu.ts`);
  return item;
};

const signatures: { dish: string; photo: PhotoKey; caption?: string }[] = [
  { dish: 'Cajun Seafood Boil', photo: 'seafoodBoilBowl' },
  { dish: 'Sautéed Jumbo Shrimp', photo: 'sauteedJumboShrimp' },
  { dish: 'Dirty Fries', photo: 'dirtyFries' },
  { dish: 'Bone-In Ribeye', photo: 'ribeyeWithShrimp', caption: 'Pictured topped with jumbo shrimp.' },
];

const menuShortcuts = menu
  .filter((s) => s.layout !== 'compact')
  .map((s) => ({ id: s.id, title: s.title, count: s.items.length }));

const gallery: { photo: PhotoKey; wide?: boolean }[] = [
  { photo: 'oystersNeon', wide: true },
  { photo: 'tostadas' },
  { photo: 'dessertSlice' },
  { photo: 'fishOverGreens' },
  { photo: 'dessertCreamPour' },
  { photo: 'seafoodBoilHero', wide: true },
];
---

<Base
  title="Blue Seafood & Grill | Seafood Restaurant in Arroyo Grande, CA"
  description="Fresh surf & turf in Arroyo Grande: oysters, Cajun seafood boils, lobster rolls, shrimp tacos and bone-in ribeye. Open Tuesday–Sunday on East Grand Avenue."
  path="/"
>
  <!-- Hero -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero-media">
      <Photo
        name="seafoodBoilHero"
        sizes="100vw"
        widths={[640, 960, 1280, 1920, 2400]}
        eager
      />
    </div>
    <div class="container hero-content">
      <p class="eyebrow">Arroyo Grande · Central Coast</p>
      <h1 id="hero-title" class="heading-xl">
        Fresh surf &amp; turf <em>in Arroyo Grande</em>
      </h1>
      <p class="lede">
        Oysters, Cajun seafood boils, lobster rolls and melted shrimp tacos — with a bone-in ribeye
        for the turf side of the table. On East Grand Avenue, open Tuesday through Sunday.
      </p>
      <div class="btn-row">
        <a class="btn btn-light" href="/menu"><Icon name="menu" /> View the menu</a>
        <a class="btn btn-ghost-light" href={business.links.reserve} target="_blank" rel="noopener">
          <Icon name="calendar" /> Reserve a table
        </a>
      </div>
      <OpenStatus class="hero-status" />
    </div>
  </section>

  <!-- Quick info -->
  <section class="quick-info" aria-label="Hours, location and reservations">
    <div class="container quick-grid">
      <div class="quick-card">
        <Icon name="clock" class="quick-icon" />
        <h2 class="quick-title">Hours</h2>
        <dl class="quick-hours">
          {
            business.hoursSummary.map((h) => (
              <div>
                <dt>{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="quick-card">
        <Icon name="pin" class="quick-icon" />
        <h2 class="quick-title">Location</h2>
        <address>{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}</address>
        <a class="text-link" href={business.links.directions} target="_blank" rel="noopener">
          Get directions <Icon name="arrowRight" size={18} />
        </a>
      </div>
      <div class="quick-card">
        <Icon name="calendar" class="quick-icon" />
        <h2 class="quick-title">Reservations</h2>
        <p>Book online through Reserve with Google, or give us a call.</p>
        <div class="quick-links">
          <a class="text-link" href={business.links.reserve} target="_blank" rel="noopener">
            Reserve online <Icon name="arrowRight" size={18} />
          </a>
          <a class="text-link" href={business.phone.href}>{business.phone.display}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Signatures -->
  <section class="section signatures" aria-labelledby="signatures-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">From the kitchen</p>
        <h2 id="signatures-title" class="heading-lg">A taste of the menu</h2>
        <p class="lede">
          From a Cajun seafood boil built for sharing to truffle-parmesan dirty fries — a few
          plates straight from our kitchen.
        </p>
      </div>

      <ul role="list" class="signature-grid">
        {
          signatures.map(({ dish, photo, caption }, i) => {
            const item = findItem(dish);
            return (
              <li class:list={['signature', { 'signature-lead': i === 0 }]}>
                <div class="media signature-media">
                  <Photo
                    name={photo}
                    sizes={i === 0 ? '(min-width: 960px) 50vw, 100vw' : '(min-width: 960px) 25vw, (min-width: 640px) 50vw, 100vw'}
                  />
                </div>
                <div class="signature-body">
                  <h3 class="heading-sm">{item.name}</h3>
                  {item.description && <p>{item.description}</p>}
                  {caption && <p class="signature-caption">{caption}</p>}
                </div>
              </li>
            );
          })
        }
      </ul>

      <div class="signatures-cta">
        <a class="btn btn-primary" href="/menu">See the full menu <Icon name="arrowRight" /></a>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section story bg-sand" aria-labelledby="story-title">
    <div class="container story-grid">
      <div class="story-media">
        <div class="media story-main">
          <Photo name="storefrontEvening" sizes="(min-width: 960px) 40vw, 100vw" />
        </div>
        <div class="media story-inset">
          <Photo name="oystersNeon" sizes="(min-width: 960px) 20vw, 50vw" widths={[400, 700, 1080]} />
        </div>
      </div>

      <div class="story-copy stack">
        <p class="eyebrow">Our place</p>
        <h2 id="story-title" class="heading-lg">A neighborhood seafood house on Grand Avenue</h2>
        <WaveRule />
        <p>
          Blue Seafood &amp; Grill opened in Arroyo Grande in {business.openedYear}, bringing a
          seafood-first menu to East Grand Avenue — a short drive from Pismo Beach, Grover Beach and
          the rest of the Five Cities.
        </p>
        <p>
          The menu leans into the coast: oysters grilled, fried or Rockefeller-style, Cajun seafood
          boils, cioppino and a pan roast finished with smoked tomato cream. For the turf side there is
          a bone-in ribeye and a Western burger, plus vegetarian and vegan dishes and a kids menu.
        </p>
        <p>
          <a class="text-link" href="/about">More about Blue <Icon name="arrowRight" size={18} /></a>
        </p>
      </div>
    </div>
  </section>

  <!-- Menu shortcuts -->
  <section class="section-tight menu-shortcuts" aria-labelledby="shortcuts-title">
    <div class="container shortcuts-inner">
      <div>
        <p class="eyebrow">Browse the menu</p>
        <h2 id="shortcuts-title" class="heading-md">Jump straight to what you’re craving</h2>
      </div>
      <ul role="list" class="shortcut-list">
        {
          menuShortcuts.map((s) => (
            <li>
              <a href={`/menu#${s.id}`} class="shortcut">
                <span>{s.title}</span>
                <span class="shortcut-count">{s.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Reviews />

  <!-- Gallery / Instagram -->
  <section class="section gallery" aria-labelledby="gallery-title">
    <div class="container">
      <div class="gallery-head">
        <div class="section-head">
          <p class="eyebrow">Gallery</p>
          <h2 id="gallery-title" class="heading-lg">Fresh from the pass</h2>
          <p class="lede">
            For news and more photos, follow along on Instagram at
            {' '}<a class="text-link" href={business.links.instagram} target="_blank" rel="noopener">{business.links.instagramHandle}</a>.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href={business.links.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" /> Follow on Instagram
          </a>
          <a class="btn btn-outline" href={business.links.facebook} target="_blank" rel="noopener">
            <Icon name="facebook" /> Facebook
          </a>
        </div>
      </div>

      <ul role="list" class="gallery-grid">
        {
          gallery.map(({ photo, wide }) => (
            <li class:list={['media', 'gallery-item', { 'gallery-wide': wide }]}>
              <Photo name={photo} sizes={wide ? '(min-width: 960px) 50vw, 100vw' : '(min-width: 960px) 25vw, 50vw'} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Visit CTA -->
  <section class="section-tight visit-cta bg-deep on-dark" aria-labelledby="visit-title">
    <div class="container visit-inner">
      <div class="stack">
        <p class="eyebrow">Plan your visit</p>
        <h2 id="visit-title" class="heading-lg">See you on Grand Avenue</h2>
        <p class="lede">{fullAddress}</p>
      </div>
      <div class="btn-row visit-actions">
        <a class="btn btn-light" href={business.links.directions} target="_blank" rel="noopener">
          <Icon name="directions" /> Directions
        </a>
        <a class="btn btn-ghost-light" href={business.phone.href}><Icon name="phone" /> {business.phone.display}</a>
        <a class="btn btn-ghost-light" href="/visit">Hours &amp; map</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(88svh, 52rem);
    padding-block: 7rem 5.5rem;
    color: var(--white);
    background: var(--navy-950);
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgb(6 20 35 / 0.95) 0%, rgb(6 20 35 / 0.55) 45%, rgb(6 20 35 / 0.2) 75%),
      linear-gradient(90deg, rgb(6 20 35 / 0.55) 0%, transparent 70%);
  }

  .hero-content {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .hero h1 {
    max-width: 15ch;
    font-weight: 450;
  }

  .hero h1 em {
    display: block;
    font-style: italic;
    color: var(--blue-300);
  }

  .hero .lede {
    max-width: 34rem;
  }

  .hero :global(.hero-status) {
    color: rgb(247 241 230 / 0.9);
  }

  /* Quick info */
  .quick-info {
    position: relative;
    z-index: 2;
    margin-top: -3rem;
  }

  .quick-grid {
    display: grid;
    gap: 1rem;
  }

  .quick-card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .quick-card :global(.quick-icon) {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--blue-600);
  }

  .quick-title {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass-500);
  }

  .quick-hours {
    display: grid;
    gap: 0.35rem;
  }

  .quick-hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .quick-hours dt {
    color: var(--ink-soft);
  }

  .quick-hours dd {
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  /* Signatures */
  .signature-grid {
    display: grid;
    gap: 1.5rem;
  }

  .signature {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .signature-media {
    aspect-ratio: 4 / 3;
  }

  .signature-body {
    display: grid;
    gap: 0.4rem;
  }

  .signature-body p {
    color: var(--ink-soft);
  }

  .signature-caption {
    font-size: 0.88rem;
    font-style: italic;
  }

  .signatures-cta {
    margin-top: 2.5rem;
  }

  /* Story */
  .story-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .story-media {
    position: relative;
    padding-bottom: 3rem;
  }

  .story-main {
    aspect-ratio: 4 / 3;
  }

  .story-inset {
    position: absolute;
    right: -0.5rem;
    bottom: 0;
    width: 46%;
    aspect-ratio: 1;
    border: 6px solid var(--sand-100);
    box-shadow: var(--shadow);
  }

  .story-copy p:not(.eyebrow) {
    max-width: 36rem;
    color: var(--ink-soft);
  }

  /* Menu shortcuts */
  .shortcuts-inner {
    display: grid;
    gap: 2rem;
  }

  .shortcut-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .shortcut {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.9rem;
    padding: 0.55rem 0.7rem 0.55rem 1.15rem;
    border: 1px solid var(--sand-300);
    border-radius: 999px;
    background: var(--white);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .shortcut:hover {
    border-color: var(--blue-600);
    background: var(--sand-50);
  }

  .shortcut-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding-inline: 0.4rem;
    border-radius: 999px;
    background: var(--sand-100);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  /* Gallery */
  .gallery-head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }

  .gallery-head .section-head {
    margin-bottom: 0;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .gallery-item {
    aspect-ratio: 1;
    border-radius: var(--radius);
  }

  .gallery-wide {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }

  /* Visit CTA */
  .visit-inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 640px) {
    .quick-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .quick-card:last-child {
      grid-column: span 2;
    }

    .signature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: 9rem 8rem;
    }

    .quick-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .quick-card:last-child {
      grid-column: auto;
    }

    .signature-grid {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 2rem;
    }

    .signature-lead {
      grid-row: span 2;
    }

    .signature-lead .signature-media {
      aspect-ratio: 1;
    }

    /* Last card spans the two small columns, image beside text */
    .signature:last-child {
      grid-column: 2 / span 2;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      align-self: end;
      gap: 1.5rem;
    }

    .story-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 5rem;
    }

    .shortcuts-inner {
      grid-template-columns: 1fr 1.3fr;
      align-items: center;
    }

    .gallery-head {
      grid-template-columns: 1fr auto;
    }

    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .visit-inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
