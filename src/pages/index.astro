---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import Reviews from '../components/Reviews.astro';
import SpecialsPopup from '../components/SpecialsPopup.astro';
import { business } from '../data/business';
import { menu } from '../data/menu';
import { categoryBySection, dishByName } from '../data/pages';

// Dish names must match src/data/menu.ts exactly; the build fails if one is renamed or removed.
// An optional third value is a shorter display label (e.g. "Seafood Alfredo" for "Seafood Alfredo Pasta").
const menuNames = new Set(menu.flatMap((s) => s.items.map((i) => i.name)));
const dishes = (list: [string, string, string?][]) =>
  list.map(([name, short, label]) => {
    if (!menuNames.has(name)) throw new Error(`Home page dish "${name}" is not in src/data/menu.ts`);
    const page = dishByName.get(name);
    return { name: label ?? name, short, href: page ? `/menu/${page.slug}` : undefined };
  });

const boils = dishes([
  ['Cajun Seafood Boil', 'crab · lobster · shrimp · corn · and more'],
  ['Pan Roast', 'an assortment of seafood · smoked tomato cream · jasmine rice'],
  ['Cioppino', 'an assortment of seafood · tomato-herb broth · crostini'],
  ['Seafood Alfredo Pasta', 'Linguini with house-made Alfredo sauce and an assortment of seafood.'],
]);

const plates = dishes([
  ['Sautéed Jumbo Shrimp', 'roasted garlic cream · sourdough'],
  ['Melted Shrimp Tacos (3)', 'blackened shrimp · cilantro aioli'],
  ['Lobster Roll', 'New England roll · dirty fries'],
  ['Bone-In Ribeye', 'peppercorn sauce · asparagus'],
]);

// Homepage menu preview: numbered categories with a few real dish names each.
const preview: { id: string; title: string; sample: string }[] = [
  { id: 'oysters', title: 'Oysters', sample: 'Rockefeller · Grilled with garlic butter · Fried' },
  { id: 'starters', title: 'Starters', sample: 'Crab cakes · Calamari · Shrimp ceviche tostadas · Seared ahi' },
  { id: 'steamers', title: 'Steamers & Boils', sample: 'Cajun boil · Pan roast · Cioppino · Sautéed clams' },
  { id: 'entrees', title: 'Entrées', sample: 'Shrimp tacos · Lobster roll · Fish n’ chips · Ribeye' },
  { id: 'salads', title: 'Salads, Sides & Kids', sample: 'Wedge · Caesar · Dirty fries · Kids fish n’ chips' },
];
const menuIds = new Set(menu.map((s) => s.id));
for (const p of preview) if (!menuIds.has(p.id)) throw new Error(`Menu section #${p.id} not found`);
---

<Base
  title="Blue Seafood & Grill | Seafood Restaurant in Arroyo Grande"
  description="Oysters, Cajun seafood boils, shrimp tacos, lobster rolls and steak at 1351 E Grand Ave in Arroyo Grande. Lunch and dinner Tuesday–Sunday; closed Mondays."
  path="/"
  headerOverlay
>
  <!-- Hero: bright photo, white panel overlapping its lower edge -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-photo fill">
      <Photo name="seafoodBoilHero" sizes="100vw" widths={[640, 800, 960, 1280, 1920, 2400]} eager />
    </div>
    <div class="hero-panel">
      <p class="label">Seafood &amp; grill · Arroyo Grande</p>
      <h1 id="hero-title" class="display-xl">Seafood boils, oysters &amp; <em>a hot grill</em> on Grand Avenue</h1>
      <p class="hero-sub">Lunch and dinner, Tuesday through Sunday, at 1351 E Grand Ave.</p>
      <div class="btn-row">
        <a class="btn" href="/menu"><Icon name="menu" /> View the menu</a>
        <a class="btn btn-ghost" href={business.links.reserve} target="_blank" rel="noopener">Reserve a table</a>
      </div>
      <a class="text-link hero-order" href={business.links.order} target="_blank" rel="noopener">
        <Icon name="bag" size={18} /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span>
      </a>
      <OpenStatus class="hero-status" />
    </div>
  </section>

  <!-- What we cook -->
  <section class="container intro" aria-labelledby="intro-title">
    <h2 id="intro-title" class="label">What we cook</h2>
    <p class="intro-text">
      Oysters grilled with garlic butter, baked Rockefeller-style or fried. A Cajun boil with crab,
      lobster, shrimp, corn and more for the middle of the table. <em>Melted shrimp tacos</em>, a lobster
      roll with truffle-parmesan fries, and a bone-in ribeye for whoever came for steak.
    </p>
  </section>

  <!-- Spread 1: Steamers & Boils -->
  <section class="spread" aria-labelledby="boils-title">
    <div class="spread-media">
      <div class="spread-big fill"><Photo name="seafoodBoilBowl" sizes="(min-width: 960px) 58vw, 100vw" /></div>
      <div class="spread-small fill"><Photo name="dirtyFries" sizes="(min-width: 960px) 20vw, 50vw" widths={[400, 700, 1000]} /></div>
    </div>
    <div class="spread-copy">
      <p class="label cond-label"><span class="cond">Steamers &amp; Boils</span></p>
      <h2 id="boils-title" class="display-lg">An assortment of seafood <em>on the plate</em></h2>
      <p class="spread-tagline">Built for a seafood feast.</p>
      <ul role="list" class="dish-list">
        {boils.map((d) => <li>{d.href ? <a class="name dish-link" href={d.href}>{d.name}</a> : <span class="name">{d.name}</span>}<span class="desc">{d.short}</span></li>)}
      </ul>
      <a class="text-link" href="/menu/steamers-and-boils">All steamers &amp; boils <Icon name="arrowRight" size={16} /></a>
    </div>
  </section>

  <!-- Spread 2: Starters & Entrées -->
  <section class="spread spread-rev" aria-labelledby="plates-title">
    <div class="spread-media">
      <div class="spread-big fill"><Photo name="sauteedJumboShrimp" sizes="(min-width: 960px) 58vw, 100vw" /></div>
    </div>
    <div class="spread-copy">
      <p class="label cond-label"><span class="cond">Starters &amp; Entrées</span></p>
      <h2 id="plates-title" class="display-lg">Shrimp on sourdough, <em>steak off the grill</em></h2>
      <ul role="list" class="dish-list">
        {plates.map((d) => <li>{d.href ? <a class="name dish-link" href={d.href}>{d.name}</a> : <span class="name">{d.name}</span>}<span class="desc">{d.short}</span></li>)}
      </ul>
      <a class="text-link" href="/menu/entrees">All entrées <Icon name="arrowRight" size={16} /></a>
    </div>
  </section>

  <!-- Menu preview: numbered categories + oysters -->
  <section class="board bg-navy on-dark" aria-labelledby="board-title">
    <div class="container board-grid">
      <figure class="board-photo">
        <div class="fill"><Photo name="oystersFeature" sizes="(min-width: 960px) 45vw, 100vw" widths={[400, 660]} /></div>
        <figcaption>
          <span class="cond">Oysters</span>
          <span>Rockefeller, grilled with garlic butter, or fried — by the half dozen or dozen.</span>
        </figcaption>
      </figure>
      <div class="board-list">
        <p class="label">The menu</p>
        <h2 id="board-title" class="display-md">Pick a place to start</h2>
        <ol role="list">
          {
            preview.map((p, i) => (
              <li>
                <a href={categoryBySection.get(p.id) ? `/menu/${categoryBySection.get(p.id)!.slug}` : `/menu#${p.id}`}>
                  <span class="n cond">{String(i + 1).padStart(2, '0')}</span>
                  <span class="t cond">{p.title}</span>
                  <span class="s">{p.sample}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="btn-row">
          <a class="btn btn-light" href="/menu">Open the full menu</a>
          <a class="btn btn-ghost-light" href={business.links.order} target="_blank" rel="noopener">
            <Icon name="bag" /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- Find us: real storefront -->
  <section class="find on-dark" aria-labelledby="find-title">
    <div class="find-photo fill">
      <Photo name="storefrontDay" sizes="100vw" widths={[640, 1000, 1400, 1846]} />
    </div>
    <div class="find-panel">
      <p class="label">Find us</p>
      <h2 id="find-title" class="display-lg">1351 E Grand Ave, <em>Arroyo Grande</em></h2>
      <p class="find-note">On East Grand Avenue between Courtland Street and Elm Street. Look for the Blue sign above the awning and the “Seafood” and “Oysters” neon in the front windows.</p>
      <dl class="find-hours">
        {
          business.hoursSummary.map((h) => (
            <div>
              <dt>{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="btn-row">
        <a class="btn btn-light" href={business.links.directions} target="_blank" rel="noopener">
          <Icon name="directions" /> Directions
        </a>
        <a class="btn btn-ghost-light" href={business.phone.href}><Icon name="phone" /> {business.phone.display}</a>
      </div>
    </div>
  </section>

  <SpecialsPopup />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    margin-top: calc(-1 * var(--header-h));
  }

  .hero-photo {
    height: max(17rem, 46svh);
  }

  .hero-photo :global(img) {
    object-position: 38% 58%;
  }

  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 8rem;
    background: linear-gradient(rgb(6 18 30 / 0.55), transparent);
    pointer-events: none;
  }

  .hero-panel {
    position: relative;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    margin: -3rem var(--gutter) 0;
    padding: 1.5rem 1.35rem 1.6rem;
    background: var(--paper);
  }

  .hero-panel h1 {
    font-size: clamp(2.3rem, 1.6rem + 3.6vw, 5rem);
  }

  .hero-sub {
    color: var(--soft);
  }

  .hero-order {
    font-size: 0.95rem;
  }

  .hero-panel :global(.hero-status) {
    color: var(--soft);
    font-size: 0.88rem;
  }

  /* ---------- Intro ---------- */
  .intro {
    display: grid;
    gap: 1rem;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .intro-text {
    max-width: 54rem;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: 1.28;
    letter-spacing: -0.01em;
  }

  .intro-text em {
    color: var(--blue);
  }

  /* ---------- Spreads ---------- */
  .spread {
    display: grid;
    gap: 2rem;
    margin-bottom: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .spread-media {
    position: relative;
  }

  .spread-big {
    aspect-ratio: 5 / 4;
  }

  .spread-small {
    position: relative;
    width: 48%;
    aspect-ratio: 3 / 4;
    margin: -5.5rem var(--gutter) 0 auto;
    border: 6px solid var(--paper);
  }

  .spread-rev .spread-small {
    margin: -5.5rem auto 0 var(--gutter);
  }

  .spread-copy {
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: start;
    padding-inline: var(--gutter);
  }

  .spread-copy .dish-list {
    width: 100%;
  }

  .dish-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }

  .dish-link:hover {
    color: var(--blue);
  }

  .spread-tagline {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-style: italic;
    color: var(--soft);
    margin-top: -0.35rem;
  }

  .cond-label {
    letter-spacing: 0;
  }

  .cond-label .cond {
    font-size: 1.15rem;
    letter-spacing: 0.08em;
  }

  /* ---------- Menu board ---------- */
  .board {
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  .board-grid {
    display: grid;
    gap: 2.5rem;
  }

  .board-photo {
    display: grid;
    gap: 1rem;
  }

  .board-photo .fill {
    aspect-ratio: 660 / 470;
    background: var(--navy-2);
  }

  .board-photo figcaption {
    display: grid;
    gap: 0.3rem;
    color: rgb(255 253 249 / 0.82);
  }

  .board-photo figcaption .cond {
    font-size: 2.4rem;
    color: var(--paper);
  }

  .board-list {
    display: grid;
    gap: 1rem;
    justify-items: start;
    align-content: center;
  }

  .board ol {
    width: 100%;
    margin-block: 0.5rem 1rem;
    border-top: 1px solid var(--line-dark);
  }

  .board li a {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 0.25rem 0.9rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line-dark);
    text-decoration: none;
  }

  .board li a:hover .t {
    color: var(--blue-light);
  }

  .board .n {
    grid-row: span 2;
    padding-top: 0.2rem;
    font-size: 1.2rem;
    color: var(--blue-light);
  }

  .board .t {
    font-size: 2rem;
    transition: color 0.2s var(--ease);
  }

  .board .s {
    font-size: 0.92rem;
    color: rgb(255 253 249 / 0.75);
  }

  /* ---------- Find us ---------- */
  .find {
    display: grid;
    background: var(--navy);
    color: var(--paper);
  }

  .find-photo {
    aspect-ratio: 4 / 3;
    background: var(--navy-2);
  }

  .find-photo :global(img) {
    object-position: 41% 40%;
  }

  .find-panel {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 2.25rem var(--gutter) 3rem;
  }

  .find-note {
    color: rgb(255 253 249 / 0.82);
  }

  .find-hours {
    display: grid;
    gap: 0.35rem;
    width: 100%;
    max-width: 22rem;
    margin-block: 0.5rem;
  }

  .find-hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .find-hours dt {
    color: rgb(255 253 249 / 0.75);
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 960px) {
    .hero-photo {
      height: min(84svh, 52rem);
      min-height: 34rem;
    }

    .hero-panel {
      max-width: 46rem;
      margin: -10rem 0 0 var(--edge);
      padding: 2.75rem 3rem 2.75rem;
    }

    .spread {
      grid-template-columns: 7fr 5fr;
      gap: 5rem;
      align-items: center;
    }

    .spread-rev {
      grid-template-columns: 5fr 7fr;
    }

    .spread-rev .spread-copy {
      order: -1;
      padding: 0 0 0 var(--edge);
    }

    .spread-copy {
      padding: 0 var(--edge) 0 0;
    }

    .spread-big {
      aspect-ratio: 4 / 3.1;
    }

    .spread-small {
      position: absolute;
      width: 34%;
      right: -3rem;
      bottom: -3.5rem;
      margin: 0;
    }

    .spread-rev .spread-small {
      right: auto;
      left: -3rem;
      margin: 0;
    }

    .board-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 5rem;
      align-items: center;
    }

    .board-photo .fill {
      aspect-ratio: 4 / 4.2;
    }

    .board .t {
      font-size: 2.5rem;
    }

    .find {
      position: relative;
      display: block;
    }

    .find-photo {
      aspect-ratio: auto;
      height: min(88svh, 46rem);
    }

    .find-photo :global(img) {
      object-position: 36% 45%;
    }

    .find-photo::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(270deg, rgb(11 34 54 / 0.9) 0%, rgb(11 34 54 / 0.55) 38%, transparent 62%);
    }

    .find-panel {
      position: absolute;
      top: 50%;
      right: var(--edge);
      width: min(30rem, 40%);
      padding: 0;
      transform: translateY(-50%);
    }
  }
</style>
