---
import Base from '../layouts/Base.astro';
import ArtPhoto from '../components/ArtPhoto.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { menu, menuNotice, consumerAdvisory, menuLastReviewed, tagLabels } from '../data/menu';
import { menuSchema, breadcrumbSchema } from '../lib/schema';
import { categoryBySection, dishByName } from '../data/pages';

const site = Astro.site ?? new URL(Astro.url.origin);
const lastReviewed = new Date(`${menuLastReviewed}T12:00:00Z`).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title="Menu | Blue Seafood & Grill, Arroyo Grande"
  description="The Blue Seafood & Grill menu: oysters, crab cakes, Cajun seafood boil, cioppino, lobster rolls, fish tacos, bone-in ribeye, salads, vegan dishes and a kids menu."
  path="/menu"
  headerOverlay
  schema={[
    menuSchema(site),
    breadcrumbSchema(site, [
      { name: 'Home', path: '/' },
      { name: 'Menu', path: '/menu' },
    ]),
  ]}
>
  <section class="menu-hero" aria-labelledby="menu-title">
    <div class="menu-hero-photo fill">
      <ArtPhoto desktop="oystersWide" mobile="oystersTall" breakpoint={768} eager />
    </div>
    <div class="menu-hero-panel">
      <p class="label">Blue Seafood &amp; Grill</p>
      <h1 id="menu-title" class="display-xl">The <em>menu</em></h1>
      <p class="muted">
        Oysters and starters, steamers and boils, seafood and steak entrées, salads, sides and a kids
        menu. {menuNotice}
      </p>
      <div class="btn-row">
        <a class="btn" href={business.links.order} target="_blank" rel="noopener"><Icon name="bag" /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span></a>
        <a class="btn btn-ghost" href={business.links.reserve} target="_blank" rel="noopener"><Icon name="calendar" /> Reserve a table</a>
      </div>
      <p class="muted order-note">Online orders are placed through DoorDash. Prefer to call? {business.phone.display}.</p>
    </div>
  </section>

  <nav class="menu-nav" aria-label="Menu sections" data-menu-nav>
    <div class="menu-nav-inner">
      <ul role="list" class="menu-nav-list" data-menu-scroller>
        {
          menu.map((s) => (
            <li>
              <a href={`#${s.id}`} data-menu-link={s.id} class="cond">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="menu-nav-more" type="button" data-menu-more aria-label="Show more menu sections" hidden>
        <Icon name="arrowRight" />
      </button>
    </div>
  </nav>

  <div class="container menu-body">
    {
      menu.map((section, index) => {
        const featured = section.items.filter((i) => i.photo);
        const rest = section.items.filter((i) => !i.photo);
        return (
          <section class="menu-section" id={section.id} aria-labelledby={`${section.id}-title`} data-menu-section>
            <header class="section-head">
              <span class="section-num cond" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h2 id={`${section.id}-title`} class="display-md">{section.title}</h2>
              {section.intro && <p class="muted">{section.intro}</p>}
              {categoryBySection.get(section.id) && (
                <a class="text-link section-more" href={`/menu/${categoryBySection.get(section.id)!.slug}`}>
                  More about {section.title.toLowerCase()} <Icon name="arrowRight" size={15} />
                </a>
              )}
            </header>

            {featured.map((item) => (
              <article class="featured">
                <div class="featured-photo fill">
                  <Photo name={item.photo!} sizes="(min-width: 960px) 44vw, 100vw" />
                </div>
                <div class="featured-copy">
                  <p class="label">Featured</p>
                  <h3 class="display-sm">
                    {dishByName.get(item.name) ? <a class="dish-link" href={`/menu/${dishByName.get(item.name)!.slug}`}>{item.name}</a> : item.name}
                  </h3>
                  {(item.popular || item.tags?.length) && (
                    <p class="item-tags">
                      {item.popular && <span class="tag tag-fav">Guest favorite</span>}
                      {item.tags?.map((t) => <span class="tag">{tagLabels[t]}</span>)}
                    </p>
                  )}
                  {item.description && <p class="featured-desc">{item.description}</p>}
                  {item.note && <p class="item-note">{item.note}</p>}
                  {item.photoNote && <p class="photo-note">{item.photoNote}</p>}
                </div>
              </article>
            ))}

            {section.layout === 'compact' ? (
              <ul role="list" class="compact-list">
                {rest.map((item) => <li>{item.name}</li>)}
              </ul>
            ) : (
              rest.length > 0 && (
                <ul role="list" class="item-list">
                  {rest.map((item) => (
                    <li class="menu-item">
                      <h3 class="item-name">
                        {dishByName.get(item.name) ? <a class="dish-link" href={`/menu/${dishByName.get(item.name)!.slug}`}>{item.name}</a> : item.name}
                      </h3>
                      {(item.popular || item.tags?.length) && (
                        <p class="item-tags">
                          {item.popular && <span class="tag tag-fav">Guest favorite</span>}
                          {item.tags?.map((t) => <span class="tag">{tagLabels[t]}</span>)}
                        </p>
                      )}
                      {item.description && <p class="item-desc">{item.description}</p>}
                      {item.note && <p class="item-note">{item.note}</p>}
                    </li>
                  ))}
                </ul>
              )
            )}
          </section>
        );
      })
    }

    <footer class="menu-footnotes">
      <p><strong>Labels.</strong> “Guest favorite” marks dishes mentioned often in public reviews.</p>
      <p><strong>Allergies.</strong> Please tell your server about any food allergies before you order.</p>
      <p><strong>Advisory.</strong> {consumerAdvisory}</p>
      <p>Menu last reviewed {lastReviewed}. For current pricing, please call {business.phone.display}.</p>
    </footer>
  </div>

  <section class="menu-cta bg-navy on-dark" aria-labelledby="menu-cta-title">
    <div class="container menu-cta-inner">
      <h2 id="menu-cta-title" class="display-md">See you on <em>Grand Avenue</em></h2>
      <div class="btn-row">
        <a class="btn btn-light" href={business.links.order} target="_blank" rel="noopener"><Icon name="bag" /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span></a>
        <a class="btn btn-ghost-light" href={business.links.reserve} target="_blank" rel="noopener"><Icon name="calendar" /> Reserve a table</a>
        <a class="btn btn-ghost-light" href={business.links.directions} target="_blank" rel="noopener"><Icon name="directions" /> Directions</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .menu-hero {
    margin-top: calc(-1 * var(--header-h));
  }

  .menu-hero-photo {
    height: max(19rem, 52svh);
    background: var(--navy);
  }

  .menu-hero-photo :global(img) {
    object-position: 50% 70%;
  }

  .menu-hero-photo::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 8rem;
    background: linear-gradient(rgb(6 18 30 / 0.6), transparent);
  }

  .menu-hero-panel {
    position: relative;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    margin: -3rem var(--gutter) 0;
    padding: 1.5rem 1.35rem 1.6rem;
    background: var(--paper);
  }

  .order-note {
    font-size: 0.88rem;
  }

  /* ---------- Sticky, clearly scrollable section nav ---------- */
  .menu-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    margin-top: 2rem;
    background: var(--paper);
    border-block: 1px solid var(--line);
  }

  .menu-nav-inner {
    position: relative;
    width: min(100%, calc(var(--max) + 2 * var(--gutter)));
    margin-inline: auto;
  }

  .menu-nav-list {
    display: flex;
    gap: 0.35rem;
    padding: 0.6rem var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .menu-nav-list li {
    flex: none;
    scroll-snap-align: start;
  }

  .menu-nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0.35rem 0.95rem;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--soft);
  }

  .menu-nav-list a:hover {
    color: var(--navy);
    border-color: var(--line);
  }

  .menu-nav-list a[aria-current='true'] {
    background: var(--navy);
    color: var(--paper);
  }

  /* Edge fades + arrow make it obvious the row scrolls */
  .menu-nav-inner[data-overflow-end]::after {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 4.5rem;
    background: linear-gradient(90deg, rgb(255 253 249 / 0), var(--paper) 70%);
    pointer-events: none;
  }

  .menu-nav-inner[data-overflow-start]::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    width: 2.5rem;
    background: linear-gradient(270deg, rgb(255 253 249 / 0), var(--paper) 80%);
    pointer-events: none;
  }

  .menu-nav-more {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--navy);
    transform: translateY(-50%);
  }

  .menu-nav-more[hidden] {
    display: none;
  }

  .menu-nav-more :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* ---------- Sections ---------- */
  .menu-body {
    padding-block: 1rem 4rem;
  }

  .menu-section {
    scroll-margin-top: calc(var(--header-h) + 4.5rem);
    padding-block: 3rem;
    border-bottom: 1px solid var(--line);
  }

  .section-more {
    font-size: 0.9rem;
  }

  .dish-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }

  .dish-link:hover {
    text-decoration-color: currentColor;
  }

  .section-head {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    margin-bottom: 2rem;
  }

  .section-num {
    font-size: 1.3rem;
    color: var(--blue);
  }

  .featured {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .featured-photo {
    aspect-ratio: 4 / 3;
  }

  .featured-copy {
    display: grid;
    gap: 0.55rem;
    align-content: center;
    justify-items: start;
  }

  .featured-desc {
    max-width: 34rem;
    font-size: 1.05rem;
    color: var(--soft);
  }

  .photo-note {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--soft);
  }

  .item-list {
    display: grid;
    gap: 1.6rem 3.5rem;
  }

  .menu-item {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    padding-bottom: 1.4rem;
    border-bottom: 1px dashed var(--line);
  }

  .item-name {
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .item-desc {
    color: var(--soft);
  }

  .item-note {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--blue);
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--soft);
  }

  .tag-fav {
    border-color: transparent;
    background: var(--glass);
    color: var(--blue-deep);
  }

  .compact-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .compact-list li {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  .menu-footnotes {
    display: grid;
    gap: 0.5rem;
    max-width: 48rem;
    padding-top: 2.5rem;
    font-size: 0.9rem;
    color: var(--soft);
  }

  .menu-cta {
    padding-block: 3.5rem;
  }

  .menu-cta-inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 720px) {
    .item-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .menu-hero-photo {
      height: min(72svh, 44rem);
      min-height: 30rem;
    }

    .menu-hero-photo :global(img) {
      object-position: 50% 62%;
    }

    .menu-hero-panel {
      max-width: 40rem;
      margin: -9rem var(--edge) 0 auto;
      padding: 2.5rem 2.75rem;
    }

    .menu-section {
      display: grid;
      grid-template-columns: 16rem 1fr;
      column-gap: 4rem;
      padding-block: 4rem;
    }

    .section-head {
      position: sticky;
      top: calc(var(--header-h) + 5.5rem);
      align-self: start;
      grid-row: span 3;
    }

    .featured {
      grid-template-columns: 1.15fr 1fr;
      gap: 2.5rem;
      align-items: center;
    }

    .menu-cta-inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>

<script>
  const scroller = document.querySelector<HTMLElement>('[data-menu-scroller]');
  const wrap = scroller?.parentElement;
  const more = document.querySelector<HTMLButtonElement>('[data-menu-more]');
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) => links.set(a.dataset.menuLink!, a));

  // Overflow cues: edge fades and a "more" arrow while there is more to scroll.
  const syncOverflow = () => {
    if (!scroller || !wrap || !more) return;
    const max = scroller.scrollWidth - scroller.clientWidth;
    const atStart = scroller.scrollLeft <= 4;
    const atEnd = scroller.scrollLeft >= max - 4;
    wrap.toggleAttribute('data-overflow-start', max > 0 && !atStart);
    wrap.toggleAttribute('data-overflow-end', max > 0 && !atEnd);
    more.hidden = max <= 0 || atEnd;
  };
  scroller?.addEventListener('scroll', syncOverflow, { passive: true });
  window.addEventListener('resize', syncOverflow);
  syncOverflow();

  // While the visitor is scrolling the category row themselves, don't move it for them.
  let manualUntil = 0;
  const markManual = () => (manualUntil = Date.now() + 1500);
  scroller?.addEventListener('pointerdown', markManual, { passive: true });
  scroller?.addEventListener('wheel', markManual, { passive: true });

  more?.addEventListener('click', () => {
    markManual();
    scroller?.scrollBy({ left: scroller.clientWidth * 0.7, behavior: 'smooth' });
  });

  let currentId: string | null = null;
  const setCurrent = (id: string) => {
    if (id === currentId) return;
    currentId = id;
    links.forEach((a, key) => {
      if (key === id) {
        a.setAttribute('aria-current', 'true');
        // Bring the active chip into view only if it is hidden, and never mid-gesture.
        if (scroller && Date.now() > manualUntil) {
          const start = scroller.scrollLeft;
          const end = start + scroller.clientWidth;
          if (a.offsetLeft < start || a.offsetLeft + a.offsetWidth > end) {
            const left = a.offsetLeft - scroller.clientWidth / 2 + a.clientWidth / 2;
            scroller.scrollTo({ left, behavior: 'auto' });
          }
        }
      } else {
        a.removeAttribute('aria-current');
      }
    });
    syncOverflow();
  };

  // A tapped category becomes current right away (short last sections can't scroll to the spy line).
  let pinnedUntil = 0;
  links.forEach((a, id) =>
    a.addEventListener('click', () => {
      pinnedUntil = Date.now() + 1200;
      setCurrent(id);
    }),
  );

  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-section]'));
  if ('IntersectionObserver' in window && sections.length) {
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        if (Date.now() < pinnedUntil) return;
        const first = sections.find((s) => visible.has(s.id));
        if (first) setCurrent(first.id);
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
