---
/**
 * Privacy page. Describes what the site actually does (checked in a browser on 2026-09-25):
 *  - Google Analytics 4 (G-E4JB2S27XN): page views, scrolls to 90%, our click events (call,
 *    directions, order, reserve), Google's automatic outbound-link clicks. Enhanced measurement is
 *    also on for downloads, forms, site search and video (the site has none of those).
 *    Cookies _ga and _ga_E4JB2S27XN: 400 days in a Chromium test browser (expires 2027-10-30);
 *    other browsers may keep them for less, so the page states what we observed, not a rule.
 *  - Not verifiable from the site: GA4 Data retention, Google signals, Google Ads links (they live
 *    in GA4 Admin). The tag has no Google Ads (AW-) destination, which doesn't rule out a link.
 *  - sessionStorage "blue-specials-shown" for the specials message; nothing else stored.
 *  - Google map loads only after "Show interactive map". No forms, accounts or sign-ins.
 * If the site starts collecting anything else, update this page and `lastUpdated`.
 *
 * Owner review: the text was sent to the restaurant for approval. Fields set to null are pending
 * their answers; the sentence is left out until they're filled in. `lastUpdated` must be a real
 * date before publishing — the build check fails while it says DRAFT.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
import { GA_MEASUREMENT_ID } from '../data/analytics';
import { breadcrumbSchema } from '../lib/schema';

const privacy = {
  lastUpdated: 'DRAFT',
  /** GA4 Admin → Data collection and modification → Data retention (user-level and event-level data), in months. */
  retentionMonths: null as number | null,
  /** true only after GA4 Admin shows Google signals off and no Google Ads links, and the owner confirms no ad use. */
  noAdvertisingUse: null as boolean | null,
  /** Approved contact email for privacy questions. */
  email: null as string | null,
};

const site = Astro.site ?? new URL(Astro.url.origin);
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Privacy', path: '/privacy' },
];
const gaCookie = `_ga_${GA_MEASUREMENT_ID.replace(/^G-/, '')}`;
---

<Base
  title="Privacy | Blue Seafood & Grill"
  description="What the Blue Seafood & Grill website collects when you visit: Google Analytics page views and link taps, two analytics cookies, and how to opt out."
  path="/privacy"
  schema={[breadcrumbSchema(site, trail)]}
>
  <section class="info-top bg-glass">
    <div class="container info-top-inner">
      <Breadcrumbs trail={trail} />
      <p class="label">Privacy</p>
      <h1 class="display-xl">Privacy</h1>
      <p class="lede">
        {business.name} runs blueseafoodgrill.com. This page explains what the website collects when you visit, and why.
      </p>
      <p class="info-note">Last updated: {privacy.lastUpdated}</p>
    </div>
  </section>

  <div class="container-narrow privacy">
    <section aria-labelledby="p-collect">
      <h2 id="p-collect" class="display-sm">What we collect</h2>
      <p>
        We use Google Analytics 4 to see how people use the website: which pages they visit, and whether they tap to
        call us, get directions, order online or book a table. We use this to make the site easier to use.
      </p>
      <p>When you visit, Google Analytics collects:</p>
      <ul>
        <li>
          the pages you view, whether you scroll to the end of a page (Google records when you reach 90% of it), the
          page that sent you here, and when you visited;
        </li>
        <li>taps on our phone number, directions, online ordering and reservation links, and on links to other websites;</li>
        <li>general details about your device and browser, such as device type, screen size, browser and language;</li>
        <li>
          your approximate location (city or region), which Google works out from your IP address. Google Analytics 4
          does not store IP addresses.
        </li>
      </ul>
      <p>
        This website does not ask you to enter your name, email address, phone number or payment details. It has no
        forms, accounts or sign-ins. Our hosting provider still processes technical information such as IP addresses (see
        <a class="text-link" href="#p-hosting">Hosting</a> below).
      </p>
    </section>

    <section aria-labelledby="p-cookies">
      <h2 id="p-cookies" class="display-sm">Cookies</h2>
      <p>
        Google Analytics sets two cookies on blueseafoodgrill.com, named <code>_ga</code> and <code>{gaCookie}</code>.
        They hold a random ID so repeat visits can be counted. When we tested the site in a Chrome-based browser on
        September 25, 2026, both cookies were set to expire after 400 days. Your browser may keep them for a shorter time,
        and you can delete them at any time.
      </p>
      <p>
        The site also keeps one note in your browser tab so the “Ask about today’s specials” message shows only once per
        visit. It isn’t sent anywhere and is cleared when you close the tab.
      </p>
    </section>

    <section aria-labelledby="p-ga">
      <h2 id="p-ga" class="display-sm">Google Analytics</h2>
      <p>
        Google processes this information for us. Google explains how it uses data from websites that use its services
        in <a class="text-link" href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener">How Google uses information from sites or apps that use our services</a>.
        {privacy.retentionMonths &&
          ` Our Google Analytics data retention setting is ${privacy.retentionMonths} months for user-level and event-level data. This setting does not apply to standard aggregated reports.`}
        {privacy.noAdvertisingUse && ' We don’t use Google Analytics data for advertising.'}
      </p>
    </section>

    <section aria-labelledby="p-choices">
      <h2 id="p-choices" class="display-sm">Your choices</h2>
      <ul>
        <li>Block or delete cookies in your browser settings. The website works the same without them.</li>
        <li>
          Install Google’s <a class="text-link" href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics opt-out browser add-on</a>.
        </li>
        <li>Tracking protection and content blockers in your browser also stop Google Analytics.</li>
      </ul>
    </section>

    <section aria-labelledby="p-others">
      <h2 id="p-others" class="display-sm">Maps, ordering, reservations and social media</h2>
      <ul>
        <li>
          The map on our <a class="text-link" href="/visit">Visit page</a> comes from Google Maps and loads only if you
          choose “Show interactive map”. Google’s privacy policy applies to it.
        </li>
        <li>
          Online ordering (DoorDash and order.online), reservations (Reserve with Google, with table times from Yelp),
          and our Instagram and Facebook pages are run by those companies. What you share with them is covered by their
          privacy policies, not this one.
        </li>
      </ul>
    </section>

    <section aria-labelledby="p-hosting">
      <h2 id="p-hosting" class="display-sm">Hosting</h2>
      <p>
        Our website is hosted by Vercel. Like any web host, Vercel handles technical details such as IP addresses to
        deliver pages and keep the site secure. See
        <a class="text-link" href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener">Vercel’s privacy policy</a>.
      </p>
    </section>

    <section aria-labelledby="p-questions">
      <h2 id="p-questions" class="display-sm">Questions</h2>
      <p>
        Call us at <a class="text-link" href={business.phone.href}>{business.phone.display}</a>{privacy.email ? (
          <>, or email <a class="text-link" href={`mailto:${privacy.email}`}>{privacy.email}</a></>
        ) : null}.
      </p>
    </section>

    <section aria-labelledby="p-changes">
      <h2 id="p-changes" class="display-sm">Changes to this page</h2>
      <p>If we change what the website collects, we’ll update this page and the date at the top.</p>
    </section>
  </div>
</Base>

<style>
  .privacy {
    display: grid;
    gap: 2.25rem;
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .privacy section {
    display: grid;
    gap: 0.75rem;
  }

  .privacy p,
  .privacy li {
    max-width: 68ch;
    color: var(--soft);
  }

  .privacy ul {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.2rem;
    list-style: disc;
  }

  .privacy code {
    font-size: 0.92em;
    color: var(--ink);
  }
</style>
