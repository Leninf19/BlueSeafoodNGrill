---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
---

<Base
  title="Page not found | Blue Seafood & Grill"
  description="The page you were looking for could not be found. Browse the Blue Seafood & Grill menu, hours and directions."
  path="/404"
  noindex
>
  <section class="not-found bg-glass" aria-labelledby="nf-title">
    <div class="container-narrow">
      <p class="label">404</p>
      <h1 id="nf-title" class="display-xl">This one got <em>away.</em></h1>
      <p class="lede">We couldn’t find that page. It may have moved when the website was rebuilt.</p>
      <div class="btn-row">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/menu"><Icon name="menu" /> Menu</a>
        <a class="btn btn-ghost" href="/visit">Hours &amp; directions</a>
        <a class="btn btn-ghost" href={business.phone.href}><Icon name="phone" /> Call</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    align-items: center;
    min-height: 60vh;
    padding-block: 5rem;
  }

  .not-found .container-narrow {
    display: grid;
    gap: 1.25rem;
  }
</style>
