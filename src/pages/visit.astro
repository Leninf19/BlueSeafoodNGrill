---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import HoursList from '../components/HoursList.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { business, fullAddress } from '../data/business';
import { breadcrumbSchema } from '../lib/schema';

const site = Astro.site ?? new URL(Astro.url.origin);

const faqs = [
  {
    q: 'Do you take reservations?',
    a: `Yes. Book online through Reserve with Google (booking times are provided by Yelp), or call ${business.phone.display}.`,
  },
  {
    q: 'Are you open on Mondays?',
    a: 'No, we’re closed Mondays. Tuesday through Thursday we’re open 11:30 AM to 8 PM, and Friday through Sunday 11:30 AM to 8:30 PM.',
  },
  {
    q: 'Do you have vegetarian or vegan dishes?',
    a: 'Yes — Veggie Marinara Bucatini, vegan Shiitake Tacos and several salads. Let your server know about any dietary needs.',
  },
  {
    q: 'Is there a kids menu?',
    a: 'Yes: kids sliders, kids pasta with butter or marinara, and kids fish n’ chips.',
  },
  {
    q: 'Can you seat a large group?',
    a: `For larger parties, please call ${business.phone.display} ahead of time so we can check availability.`,
  },
];
---

<Base
  title="Hours, Directions & Reservations | Blue Seafood & Grill"
  description={`Blue Seafood & Grill, ${fullAddress}. Open Tue–Sun from 11:30 AM, closed Mondays. Hours, map, directions, reservations and phone.`}
  path="/visit"
  schema={[
    breadcrumbSchema(site, [
      { name: 'Home', path: '/' },
      { name: 'Visit & Contact', path: '/visit' },
    ]),
  ]}
>
  <section class="visit-top bg-glass" aria-labelledby="visit-title">
    <div class="container visit-top-grid">
      <div class="visit-top-copy">
        <p class="label">Visit &amp; contact</p>
        <h1 id="visit-title" class="display-xl">1351 E Grand Ave, <em>Arroyo Grande</em></h1>
        <OpenStatus class="visit-status" />
        <div class="btn-row">
          <a class="btn btn-blue" href={business.links.directions} target="_blank" rel="noopener"><Icon name="directions" /> Get directions</a>
          <a class="btn btn-ghost" href={business.phone.href}><Icon name="phone" /> {business.phone.display}</a>
          <a class="btn btn-ghost" href={business.links.reserve} target="_blank" rel="noopener"><Icon name="calendar" /> Reserve</a>
        </div>
        <a class="text-link" href={business.links.order} target="_blank" rel="noopener"><Icon name="bag" size={18} /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span></a>
      </div>
      <figure class="visit-sign">
        <div class="fill"><Photo name="storefrontDay" sizes="(min-width: 960px) 40vw, 100vw" widths={[480, 800, 1200, 1846]} eager /></div>
        <figcaption>Look for the Blue sign above the awning, next to the 1351 door.</figcaption>
      </figure>
    </div>
  </section>

  <section class="container visit-body" aria-label="Hours, contact and map">
    <div class="visit-info">
      <div class="info-block">
        <h2 class="label">Hours</h2>
        <HoursList />
        <p class="muted small">Holiday hours can differ — please call ahead.</p>
      </div>

      <div class="info-block">
        <h2 class="label">Reservations</h2>
        <p>Book online through Reserve with Google (booking times are provided by Yelp), or call us.</p>
        <p><a class="text-link" href={business.links.reserve} target="_blank" rel="noopener">Reserve a table <Icon name="external" size={16} /></a></p>
      </div>

      <div class="info-block">
        <h2 class="label">Pickup &amp; delivery</h2>
        <p>Order online for pickup or delivery through DoorDash. Questions? Call {business.phone.display}. <a class="text-link" href="/order">More about ordering</a></p>
        <div class="btn-row">
          <a class="btn" href={business.links.order} target="_blank" rel="noopener"><Icon name="bag" /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span></a>
        </div>
        <p class="muted small">
          The same store takes orders on <a class="text-link" href={business.links.orderOnline} target="_blank" rel="noopener">Blue’s order.online page</a> (powered by DoorDash).
        </p>
      </div>

      <div class="info-block">
        <h2 class="label">Follow along</h2>
        <ul role="list" class="social-list">
          <li><a href={business.links.instagram} target="_blank" rel="noopener me"><Icon name="instagram" /> Instagram <span class="muted">{business.links.instagramHandle}</span></a></li>
          <li><a href={business.links.facebook} target="_blank" rel="noopener me"><Icon name="facebook" /> Facebook</a></li>
          <li><a href={business.links.googleProfile} target="_blank" rel="noopener"><Icon name="google" /> Google reviews</a></li>
        </ul>
      </div>
    </div>

    <!-- Map: intentional card first; the interactive Google map loads on request. -->
    <div class="map-card on-dark" data-map-card>
      <div class="map-fallback" data-map-fallback>
        <svg class="map-art" viewBox="0 0 400 260" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor" stroke-linecap="round">
            <path d="M-10 150 L410 128" stroke-width="10" opacity=".55" />
            <path d="M60 -10 L78 270 M170 -10 L182 270 M300 -10 L292 270" stroke-width="3" opacity=".22" />
            <path d="M-10 60 L410 48 M-10 225 L410 212" stroke-width="3" opacity=".22" />
          </g>
          <text x="262" y="122" fill="currentColor" opacity=".7" font-size="11" font-family="Instrument Sans Variable, sans-serif" letter-spacing="1.5">E GRAND AVE</text>
          <g transform="translate(236 139)">
            <circle r="26" fill="currentColor" opacity=".16" />
            <path d="M0 8s-12-10.8-12-20.1A12 12 0 0 1 12-12.1C12-2.8 0 8 0 8Z" transform="translate(0 -6)" fill="#8fd3f5" />
            <circle r="4" cy="-18" fill="#0b2236" />
          </g>
        </svg>
        <div class="map-fallback-copy">
          <p class="label">Blue Seafood &amp; Grill</p>
          <p class="map-address">{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}</p>
          <div class="btn-row">
            <a class="btn btn-light" href={business.links.directions} target="_blank" rel="noopener"><Icon name="directions" /> Get directions</a>
            <a class="btn btn-ghost-light" href={business.links.appleMaps} target="_blank" rel="noopener">Apple Maps</a>
          </div>
          <button type="button" class="map-load" data-map-load hidden>Show interactive map</button>
        </div>
      </div>
      <template data-map-template>
        <iframe
          src={business.links.mapEmbed}
          title={`Map showing ${business.name} at ${fullAddress}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </template>
    </div>
  </section>

  <section class="faq-section bg-glass" aria-labelledby="faq-title">
    <div class="container-narrow">
      <p class="label">Good to know</p>
      <h2 id="faq-title" class="display-md">Before you come</h2>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq">
              <summary>
                <span>{f.q}</span>
                <span class="faq-icon" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="faq-more"><a class="text-link" href="/faq">All frequently asked questions</a></p>
    </div>
  </section>
</Base>

<style>
  .visit-top {
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .visit-top-grid {
    display: grid;
    gap: 2rem;
  }

  .visit-top-copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    align-content: center;
  }

  .visit-top-copy :global(.visit-status) {
    color: var(--soft);
  }

  .visit-sign {
    display: grid;
    gap: 0.6rem;
  }

  .visit-sign .fill {
    aspect-ratio: 4 / 3;
  }

  .visit-sign :global(img) {
    object-position: 40% 40%;
  }

  .visit-sign figcaption {
    font-size: 0.88rem;
    color: var(--soft);
  }

  .visit-body {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .visit-info {
    display: grid;
    gap: 2rem;
  }

  .info-block {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .small {
    font-size: 0.88rem;
  }

  .social-list {
    display: grid;
  }

  .social-list a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .social-list a:hover {
    color: var(--blue);
  }

  .social-list :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--blue);
  }

  /* Map card */
  .map-card {
    position: relative;
    overflow: hidden;
    min-height: 26rem;
    background: var(--navy);
    color: var(--paper);
  }

  .map-card iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map-fallback {
    display: grid;
    height: 100%;
  }

  .map-art {
    width: 100%;
    height: auto;
    max-height: 15rem;
    color: var(--blue-light);
  }

  .map-fallback-copy {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 0 1.5rem 1.75rem;
  }

  .map-address {
    font-family: var(--serif);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .map-load {
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: var(--blue-light);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* FAQ */
  .faq-section {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }

  .faq-section h2 {
    margin: 0.75rem 0 2rem;
  }

  .faq-list {
    border-top: 1px solid var(--line);
  }

  .faq {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    font-family: var(--serif);
    font-size: 1.3rem;
    list-style: none;
    cursor: pointer;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -1px;
    background: var(--blue);
    transition: transform 0.2s var(--ease);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }

  .faq-more {
    margin-top: 1.25rem;
  }

  .faq p {
    padding: 0 0 1.25rem;
    color: var(--soft);
  }

  @media (min-width: 960px) {
    .visit-top-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .visit-sign .fill {
      aspect-ratio: 5 / 4;
    }

    .visit-body {
      grid-template-columns: 1fr 1.35fr;
      gap: 4rem;
      align-items: start;
    }

    .map-card {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      min-height: 34rem;
    }

    .map-fallback {
      align-content: center;
    }

    .map-art {
      max-height: 19rem;
    }

    .map-fallback-copy {
      padding: 0 2.5rem 2.5rem;
    }
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>('[data-map-card]');
  const loadBtn = card?.querySelector<HTMLButtonElement>('[data-map-load]');
  const template = card?.querySelector<HTMLTemplateElement>('[data-map-template]');
  if (card && loadBtn && template) {
    loadBtn.hidden = false;
    loadBtn.addEventListener('click', () => {
      const frame = template.content.firstElementChild?.cloneNode(true) as HTMLIFrameElement | undefined;
      if (!frame) return;
      frame.loading = 'eager';
      card.append(frame);
      frame.focus();
    });
  }
</script>
