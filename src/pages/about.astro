---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { googleRating, googleTopics, reviews } from '../data/reviews';
import { breadcrumbSchema } from '../lib/schema';

const site = Astro.site ?? new URL(Astro.url.origin);
const topics = googleTopics.map((t) => `${t.label.toLowerCase()} (${t.count})`);
const topicsText = `${topics.slice(0, -1).join(', ')} and ${topics.at(-1)}`;
const quote = reviews[0];
---

<Base
  title="About Blue Seafood & Grill | Arroyo Grande Seafood Restaurant"
  description={`Blue Seafood & Grill opened on East Grand Avenue in Arroyo Grande in ${business.openedYear}. See the restaurant, the kitchen and what guests order most.`}
  path="/about"
  schema={[
    breadcrumbSchema(site, [
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ]),
  ]}
>
  <!-- Opening: split, kitchen photo -->
  <section class="about-open" aria-labelledby="about-title">
    <div class="open-copy">
      <p class="label">About Blue</p>
      <h1 id="about-title" class="display-xl">A seafood kitchen on <em>East Grand Avenue</em></h1>
      <p class="lede">
        Blue Seafood &amp; Grill opened in Arroyo Grande in {business.openedYear}. This is what you’ll
        find when you come in.
      </p>
    </div>
    <div class="open-photo fill">
      <Photo name="dirtyFries" sizes="(min-width: 960px) 42vw, 100vw" widths={[480, 800, 1200]} eager />
    </div>
  </section>

  <!-- 01 The place -->
  <section class="chapter chapter-place" aria-labelledby="place-title">
    <div class="place-photos">
      <div class="place-photo fill">
        <Photo name="storefrontEvening" sizes="(min-width: 960px) 62vw, 100vw" widths={[480, 640, 800, 1000]} />
      </div>
      <div class="place-inset fill">
        <Photo name="backEntranceNight" sizes="(min-width: 960px) 26vw, 58vw" widths={[480, 800, 1200]} />
      </div>
    </div>
    <div class="chapter-copy">
      <p class="chapter-num"><span class="cond">01</span> <span class="label">The place</span></p>
      <h2 id="place-title" class="display-md">Blue sign, <em>neon in the windows</em></h2>
      <p>
        The restaurant sits at {business.address.street}, with the lit blue sign above the awning.
        “Seafood” glows in one front window and “Oysters” in the next, over a counter lined with stools.
        Around back, a second sign hangs on the lattice fence by the back entrance, beside a lamp post
        and a hedge of white roses.
      </p>
      <p>
        We’re open for lunch and dinner six days a week — closed Mondays. Book a table online or call
        {' '}{business.phone.display}.
      </p>
    </div>
  </section>

  <!-- 02 The kitchen -->
  <section class="chapter chapter-kitchen" aria-labelledby="kitchen-title">
    <div class="chapter-copy">
      <p class="chapter-num"><span class="cond">02</span> <span class="label">The kitchen</span></p>
      <h2 id="kitchen-title" class="display-md">Mostly seafood, <em>plus the grill</em></h2>
      <p>
        Most of the menu comes from the water: oysters grilled, fried or Rockefeller-style, crab
        cakes, a Cajun boil with crab, lobster, clams and mussels, cioppino, halibut and miso-glazed
        salmon.
      </p>
      <p>
        The grill side covers a bone-in ribeye with peppercorn sauce, grilled lobster tail and a
        Western burger with smoked gouda and bacon. There are vegan shiitake tacos, salads and a kids
        menu too.
      </p>
      <a class="text-link" href="/menu">Read the full menu <Icon name="arrowRight" size={16} /></a>
    </div>
    <div class="kitchen-photos">
      <div class="k-big fill"><Photo name="seafoodBoilBowl" sizes="(min-width: 960px) 40vw, 100vw" /></div>
      <div class="k-small fill"><Photo name="sauteedJumboShrimp" sizes="(min-width: 960px) 22vw, 52vw" widths={[320, 480, 640, 800]} /></div>
    </div>
  </section>

  <!-- 03 What people order -->
  <section class="chapter-orders bg-glass" aria-labelledby="orders-title">
    <div class="container orders-grid">
      <div>
        <p class="chapter-num"><span class="cond">03</span> <span class="label">What people order</span></p>
        <h2 id="orders-title" class="display-md">Fish and chips, <em>then oysters</em></h2>
      </div>
      <div class="orders-copy">
        <p>
          Across {googleRating.count} Google reviews (as of {googleRating.capturedOnLabel}), the dishes
          mentioned most are {topicsText}.
        </p>
        <figure>
          <blockquote cite={business.links.googleReviews}><p>“{quote.quote}”</p></blockquote>
          <figcaption>{quote.author} · Google, {quote.when}</figcaption>
        </figure>
        <a class="text-link" href={business.links.googleReviews} target="_blank" rel="noopener">
          Read the reviews on Google <Icon name="external" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- A few more plates -->
  <section class="container strip" aria-label="More photos from the kitchen">
    <div class="strip-grid">
      <div class="fill s-1"><Photo name="tostadas" sizes="(min-width: 960px) 34vw, 100vw" widths={[480, 640, 800, 1000]} /></div>
      <div class="fill s-2"><Photo name="dessertSlice" sizes="(min-width: 960px) 22vw, 50vw" widths={[400, 750]} /></div>
      <div class="fill s-3"><Photo name="fishOverGreens" sizes="(min-width: 960px) 34vw, 50vw" widths={[480, 800, 1000]} /></div>
    </div>
  </section>

  <section class="about-visit bg-navy on-dark" aria-labelledby="about-visit-title">
    <div class="container about-visit-inner">
      <div>
        <p class="label">Come in</p>
        <h2 id="about-visit-title" class="display-md">Tuesday through Sunday, <em>from 11:30</em></h2>
      </div>
      <div class="btn-row">
        <a class="btn btn-light" href={business.links.reserve} target="_blank" rel="noopener"><Icon name="calendar" /> Reserve a table</a>
        <a class="btn btn-ghost-light" href="/visit">Hours &amp; directions</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Opening */
  .about-open {
    display: grid;
  }

  .open-copy {
    display: grid;
    gap: 1.1rem;
    align-content: center;
    padding: 3rem var(--gutter) 2.5rem;
  }

  .open-copy .lede {
    max-width: 32rem;
  }

  .open-photo {
    aspect-ratio: 4 / 3;
  }

  .open-photo :global(img) {
    object-position: 50% 45%;
  }

  /* Chapters */
  .chapter {
    display: grid;
    gap: 2rem;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem) 0;
  }

  .chapter-copy {
    display: grid;
    gap: 1rem;
    align-content: center;
    justify-items: start;
    padding-inline: var(--gutter);
  }

  .chapter-copy > p:not(.chapter-num) {
    max-width: 34rem;
    color: var(--soft);
  }

  .chapter-num {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .chapter-num .cond {
    font-size: 1.5rem;
    color: var(--blue);
  }

  .place-photo {
    aspect-ratio: 4 / 3;
  }

  .place-photos {
    position: relative;
    padding-bottom: 4rem;
  }

  .place-photo :global(img) {
    object-position: 35% 40%;
  }

  .place-inset {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    width: 58%;
    aspect-ratio: 3 / 2;
    border: 6px solid var(--paper);
  }

  .place-inset :global(img) {
    object-position: 45% 50%;
  }

  .kitchen-photos {
    position: relative;
    padding-bottom: 4rem;
  }

  .k-big {
    aspect-ratio: 4 / 3;
  }

  .k-small {
    position: absolute;
    right: var(--gutter);
    bottom: 0;
    width: 52%;
    aspect-ratio: 1;
    border: 6px solid var(--paper);
  }

  /* What people order */
  .chapter-orders {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }

  .orders-grid {
    display: grid;
    gap: 1.5rem;
  }

  .orders-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 38rem;
  }

  .orders-copy > p {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .orders-copy blockquote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1.3;
    color: var(--blue-deep);
  }

  .orders-copy figcaption {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
  }

  /* Strip */
  .strip {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .strip-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .s-1 {
    grid-column: span 2;
    aspect-ratio: 16 / 10;
  }

  .s-2,
  .s-3 {
    aspect-ratio: 3 / 4;
  }

  .about-visit {
    padding-block: 3.5rem;
  }

  .about-visit-inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .about-open {
      grid-template-columns: 1.1fr 1fr;
      min-height: min(80svh, 46rem);
    }

    .open-copy {
      padding: 4rem 4rem 4rem var(--edge);
    }

    .open-photo {
      aspect-ratio: auto;
    }

    .chapter-place {
      grid-template-columns: 1.6fr 1fr;
      gap: 4.5rem;
      align-items: center;
    }

    .chapter-place .chapter-copy {
      padding: 0 var(--edge) 0 0;
    }

    .place-photo {
      aspect-ratio: 4 / 3;
    }

    .place-photos {
      padding: 0 0 5rem 0;
    }

    .place-inset {
      right: -3rem;
      width: 42%;
    }

    .chapter-kitchen {
      grid-template-columns: 1fr 1.25fr;
      gap: 4.5rem;
      align-items: center;
    }

    .chapter-kitchen .chapter-copy {
      padding: 0 0 0 var(--edge);
    }

    .kitchen-photos {
      padding: 0 var(--edge) 5rem 0;
    }

    .k-big {
      aspect-ratio: 5 / 4;
    }

    .k-small {
      left: -3rem;
      right: auto;
      width: 40%;
    }

    .orders-grid {
      grid-template-columns: 1fr 1.3fr;
      gap: 5rem;
      align-items: start;
    }

    .strip-grid {
      grid-template-columns: 1.6fr 1fr 1.6fr;
      gap: 1rem;
    }

    .s-1 {
      grid-column: auto;
      aspect-ratio: auto;
    }

    .s-2 {
      aspect-ratio: 3 / 4;
    }

    .s-3 {
      aspect-ratio: auto;
    }

    .about-visit-inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
