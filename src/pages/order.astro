---
/**
 * Pickup & delivery. Sources: Blue's DoorDash store and order.online page (checked 2026-09-25):
 * store name/address, pickup + delivery, online ordering hours, "Most ordered" list.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../data/business';
import { dishByName, categoryBySection } from '../data/pages';
import { menu } from '../data/menu';
import { breadcrumbSchema } from '../lib/schema';

const site = Astro.site ?? new URL(Astro.url.origin);
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Order pickup or delivery', path: '/order' },
];

// First five items of the "Most Ordered" list on DoorDash and order.online (same list, same order),
// checked 2026-09-24. Names matched to our menu.
const mostOrdered = ['Halibut Tacos (3)', 'Lobster Roll', 'Melted Shrimp Tacos (3)', 'Cajun Seafood Boil', 'Fish N’ Chips'];
const linkFor = (name: string) => {
  const d = dishByName.get(name);
  if (d) return `/menu/${d.slug}`;
  const s = menu.find((sec) => sec.items.some((i) => i.name === name));
  if (!s) throw new Error(`"${name}" not on the menu`);
  const c = categoryBySection.get(s.id);
  return c ? `/menu/${c.slug}` : `/menu#${s.id}`;
};
---

<Base
  title="Order Pickup & Delivery | Blue Seafood & Grill, Arroyo Grande"
  description="Order Blue Seafood & Grill on DoorDash for pickup at 1351 E Grand Ave in Arroyo Grande, or for delivery. See what people order most, and who to call with questions."
  path="/order"
  schema={[breadcrumbSchema(site, trail)]}
>
  <section class="info-top bg-glass">
    <div class="container info-top-inner">
      <Breadcrumbs trail={trail} />
      <p class="label">Pickup &amp; delivery</p>
      <h1 class="display-xl">Order pickup <em>or delivery</em></h1>
      <p class="lede">
        Order online on DoorDash and pick it up at {business.address.street} in {business.address.city}, or have
        it delivered.
      </p>
      <div class="btn-row">
        <a class="btn" href={business.links.order} target="_blank" rel="noopener">
          <Icon name="bag" /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span>
        </a>
        <a class="btn btn-ghost" href={business.links.directions} target="_blank" rel="noopener">
          <Icon name="directions" /> Directions for pickup
        </a>
      </div>
    </div>
  </section>

  <section class="container info-body two-col" aria-label="Ordering details">
    <div class="info-block">
      <h2 class="label">Two ways to order online</h2>
      <p>
        <a class="text-link" href={business.links.order} target="_blank" rel="noopener">DoorDash</a>: pickup or delivery.
      </p>
      <p>
        <a class="text-link" href={business.links.orderOnline} target="_blank" rel="noopener">Our order.online page</a>: the
        same menu and kitchen, on an ordering page run by DoorDash.
      </p>
      <p class="info-note">
        Online ordering can close before the dining room does, so check DoorDash for today’s ordering hours.
        We’re closed Mondays. Prices for online orders are shown on DoorDash.
      </p>
    </div>

    <div class="info-block">
      <h2 class="label">Most ordered online</h2>
      <p>The top five on DoorDash’s “Most Ordered” list for Blue (September 2026):</p>
      <ul role="list" class="dish-list">
        {
          mostOrdered.map((name) => (
            <li>
              <a class="name" href={linkFor(name)}>{name}</a>
            </li>
          ))
        }
      </ul>
      <a class="text-link" href="/menu">See the full menu <Icon name="arrowRight" size={16} /></a>
    </div>

    <div class="info-block">
      <h2 class="label">Questions about an order?</h2>
      <p>Call us at <a class="text-link" href={business.phone.href}>{business.phone.display}</a>.</p>
    </div>

    <div class="info-block">
      <h2 class="label">Rather eat here?</h2>
      <p>
        <a class="text-link" href="/reservations">Reserve a table</a> or see
        {' '}<a class="text-link" href="/visit">hours and directions</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .dish-list {
    width: 100%;
    max-width: 30rem;
  }

  .dish-list a.name {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;
  }

  .dish-list a.name:hover {
    color: var(--blue);
  }
</style>
