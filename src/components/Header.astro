---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-white.png';
import Icon from './Icon.astro';
import { business } from '../data/business';

interface Props {
  /** Start transparent over a photo hero; turns solid navy after scrolling. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const navItems = [
  { href: '/menu', label: 'Menu' },
  { href: '/about', label: 'About' },
  { href: '/visit', label: 'Visit' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
  class="site-header on-dark"
  data-header
  data-overlay={overlay ? '' : undefined}
  data-at-top={overlay ? '' : undefined}
>
  <div class="container header-inner">
    <a href="/" class="brand">
      <Image
        src={logo}
        alt={business.name}
        width={168}
        height={80}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="brand-logo"
      />
    </a>

    <nav class="primary-nav" aria-label="Main">
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span class="nav-toggle-open"><Icon name="burger" /></span>
        <span class="nav-toggle-close"><Icon name="close" /></span>
        <span class="visually-hidden" data-nav-label>Open menu</span>
      </button>

      <div class="nav-panel" id="site-nav" data-nav-panel>
        <ul role="list" class="nav-list">
          <li class="nav-home"><a href="/" class="nav-link" aria-current={current === '/' ? 'page' : undefined}>Home</a></li>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="nav-link" aria-current={current === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="nav-panel-extra">
          <a class="btn btn-light" href={business.links.order} target="_blank" rel="noopener">
            <Icon name="bag" /> Order pickup or delivery<span class="visually-hidden"> (opens DoorDash)</span>
          </a>
          <a class="btn btn-ghost-light" href={business.links.reserve} target="_blank" rel="noopener">
            <Icon name="calendar" /> Reserve a table
          </a>
          <a class="btn btn-ghost-light" href={business.phone.href}><Icon name="phone" /> {business.phone.display}</a>
          <dl class="nav-panel-hours">
            {
              business.hoursSummary.map((h) => (
                <div>
                  <dt>{h.label}</dt>
                  <dd>{h.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={business.phone.href}>
        <Icon name="phone" size={17} />
        <span>{business.phone.display}</span>
      </a>
      <a class="btn btn-light header-reserve" href={business.links.reserve} target="_blank" rel="noopener">
        Reserve<span class="header-reserve-long">&nbsp;a table</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* No backdrop-filter: it would clip the fixed-position mobile nav panel. */
    background: var(--navy);
    color: var(--paper);
    transition: background-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .site-header[data-overlay][data-at-top] {
    background: transparent;
  }

  .site-header[data-overlay][data-at-top] .brand-logo {
    filter: drop-shadow(0 1px 10px rgb(0 0 0 / 0.35));
  }

  .site-header:not([data-at-top]) {
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.06), 0 10px 30px -18px rgb(0 0 0 / 0.6);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
  }

  .brand {
    display: block;
    flex: none;
    margin-right: auto;
  }

  .brand-logo {
    width: auto;
    height: 2.8rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .header-phone:hover {
    color: var(--blue-light);
  }

  .header-reserve {
    min-height: 2.6rem;
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
  }

  .header-reserve-long {
    display: none;
  }

  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 2px;
    background: transparent;
    color: var(--white);
  }

  .nav-toggle-close,
  .nav-toggle[aria-expanded='true'] .nav-toggle-open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-close {
    display: block;
  }

  .nav-toggle :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .primary-nav {
    order: 3;
  }

  /* Mobile panel */
  .nav-panel {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    display: none;
    flex-direction: column;
    gap: 2rem;
    padding: 1.25rem var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    background: var(--navy);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav-panel.is-open {
    display: flex;
  }

  .nav-link {
    display: block;
    padding: 0.8rem 0;
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 1.15;
    text-decoration: none;
    border-bottom: 1px solid var(--line-dark);
  }

  .nav-link[aria-current='page'] {
    font-style: italic;
    color: var(--blue-light);
  }

  .nav-panel-extra {
    display: grid;
    gap: 0.7rem;
  }

  .nav-panel-hours {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.8rem;
    font-size: 0.92rem;
  }

  .nav-panel-hours div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-panel-hours dt {
    color: rgb(255 253 249 / 0.75);
  }

  @media (min-width: 640px) {
    .header-phone {
      display: inline-flex;
    }

    .header-reserve-long {
      display: inline;
    }
  }

  @media (min-width: 960px) {
    .primary-nav {
      order: 0;
    }

    .nav-toggle,
    .nav-home {
      display: none;
    }

    .nav-panel {
      position: static;
      display: block;
      padding: 0;
      background: none;
      overflow: visible;
    }

    .nav-panel-extra {
      display: none;
    }

    .nav-list {
      display: flex;
      gap: 0.4rem;
    }

    .nav-link {
      position: relative;
      padding: 0.5rem 0.8rem;
      font-family: var(--sans);
      font-size: 0.92rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      border: 0;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      left: 0.8rem;
      right: 0.8rem;
      bottom: 0.2rem;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s var(--ease);
    }

    .nav-link:hover::after,
    .nav-link[aria-current='page']::after {
      transform: scaleX(1);
    }

    .nav-link[aria-current='page'] {
      font-style: normal;
      color: inherit;
    }

    .brand-logo {
      height: 3.1rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');
  const desktop = window.matchMedia('(min-width: 960px)');
  let open = false;

  const syncTop = () => {
    if (!header?.hasAttribute('data-overlay')) return;
    header.toggleAttribute('data-at-top', window.scrollY < 24 && !open);
  };
  syncTop();
  window.addEventListener('scroll', syncTop, { passive: true });

  const outside = () =>
    Array.from(document.body.children).filter((el) => !el.matches('[data-header], script, style')) as HTMLElement[];

  function setOpen(next: boolean, returnFocus = true) {
    if (!toggle || !panel) return;
    open = next;
    toggle.setAttribute('aria-expanded', String(next));
    panel.classList.toggle('is-open', next);
    if (label) label.textContent = next ? 'Close menu' : 'Open menu';
    document.documentElement.style.overflow = next ? 'hidden' : '';
    outside().forEach((el) => (next ? el.setAttribute('inert', '') : el.removeAttribute('inert')));
    syncTop();
    if (next) panel.querySelector<HTMLElement>('a')?.focus();
    else if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => setOpen(!open));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) setOpen(false);
  });
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a') && !desktop.matches) setOpen(false, false);
  });
  desktop.addEventListener('change', (e) => {
    if (e.matches && open) setOpen(false, false);
  });
</script>
