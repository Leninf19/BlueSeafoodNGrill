---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-white.png';
import Icon from './Icon.astro';
import { business } from '../data/business';

export const navItems = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/about', label: 'About' },
  { href: '/visit', label: 'Visit & Contact' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header on-dark" data-header>
  <div class="container header-inner">
    <a href="/" class="brand">
      <Image
        src={logo}
        alt={business.name}
        width={168}
        height={80}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="brand-logo"
      />
    </a>

    <nav class="primary-nav" aria-label="Main">
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
      >
        <span class="nav-toggle-open"><Icon name="burger" /></span>
        <span class="nav-toggle-close"><Icon name="close" /></span>
        <span class="visually-hidden" data-nav-label>Open menu</span>
      </button>

      <div class="nav-panel" id="site-nav" data-nav-panel>
        <ul role="list" class="nav-list">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="nav-panel-extra">
          <a class="btn btn-light" href={business.links.reserve} target="_blank" rel="noopener">
            <Icon name="calendar" /> Reserve a table
          </a>
          <a class="btn btn-ghost-light" href={business.phone.href}>
            <Icon name="phone" /> {business.phone.display}
          </a>
          <p class="nav-panel-hours">
            {business.hoursSummary.map((h) => (
              <span>
                <strong>{h.label}</strong> {h.value}
              </span>
            ))}
          </p>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={business.phone.href}>
        <Icon name="phone" size={18} />
        <span>{business.phone.display}</span>
      </a>
      <a class="btn btn-primary header-reserve" href={business.links.reserve} target="_blank" rel="noopener">
        Reserve<span class="visually-hidden"> a table (opens Reserve with Google)</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* No backdrop-filter here: it would become the containing block for the
       fixed-position mobile nav panel and clip it to the header's height. */
    background: rgb(6 20 35 / 0.97);
    color: var(--sand-100);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
  }

  .brand {
    display: block;
    flex: none;
    margin-right: auto;
    border-radius: 6px;
  }

  .brand-logo {
    width: auto;
    height: 2.9rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--sand-100);
  }

  .header-phone:hover {
    color: var(--blue-300);
  }

  .header-reserve {
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.92rem;
  }

  /* Toggle */
  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    background: transparent;
    color: var(--white);
  }

  .nav-toggle-close,
  .nav-toggle[aria-expanded='true'] .nav-toggle-open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-close {
    display: block;
  }

  .nav-toggle :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .primary-nav {
    order: 3;
  }

  /* Mobile panel */
  .nav-panel {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    display: none;
    flex-direction: column;
    gap: 2rem;
    padding: 1.5rem var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    background: var(--navy-950);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav-panel.is-open {
    display: flex;
  }

  .nav-list {
    display: grid;
  }

  .nav-link {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
    text-decoration: none;
    color: var(--sand-100);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .nav-link[aria-current='page'] {
    color: var(--blue-300);
  }

  .nav-panel-extra {
    display: grid;
    gap: 0.75rem;
  }

  .nav-panel-hours {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: rgb(247 241 230 / 0.78);
  }

  .nav-panel-hours strong {
    color: var(--sand-100);
    font-weight: 700;
  }

  @media (min-width: 640px) {
    .header-phone {
      display: inline-flex;
    }
  }

  @media (min-width: 960px) {
    .primary-nav {
      order: 0;
    }

    .nav-toggle {
      display: none;
    }

    .nav-panel {
      position: static;
      display: block;
      padding: 0;
      background: none;
      overflow: visible;
    }

    .nav-panel-extra {
      display: none;
    }

    .nav-list {
      display: flex;
      gap: 0.25rem;
    }

    .nav-link {
      position: relative;
      padding: 0.5rem 0.85rem;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 600;
      border: 0;
      color: rgb(247 241 230 / 0.86);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      left: 0.85rem;
      right: 0.85rem;
      bottom: 0.2rem;
      height: 2px;
      border-radius: 2px;
      background: var(--blue-300);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s var(--ease);
    }

    .nav-link:hover {
      color: var(--white);
    }

    .nav-link:hover::after,
    .nav-link[aria-current='page']::after {
      transform: scaleX(1);
    }

    .nav-link[aria-current='page'] {
      color: var(--white);
    }

    .brand-logo {
      height: 3.1rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');
  const desktop = window.matchMedia('(min-width: 960px)');
  const outside = () =>
    Array.from(document.body.children).filter(
      (el) => !el.matches('[data-header], script, style'),
    ) as HTMLElement[];

  function setOpen(open: boolean, returnFocus = true) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('is-open', open);
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
    document.documentElement.style.overflow = open ? 'hidden' : '';
    outside().forEach((el) => {
      if (open) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    });
    if (open) panel.querySelector<HTMLElement>('a')?.focus();
    else if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false);
  });

  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a') && !desktop.matches) setOpen(false, false);
  });

  desktop.addEventListener('change', (e) => {
    if (e.matches && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, false);
  });
</script>
