---
import Icon from './Icon.astro';
import { business } from '../data/business';
import { googleRating, googleTopics, reviews } from '../data/reviews';

const fullStars = Math.floor(googleRating.rating);
const hasHalf = googleRating.rating - fullStars >= 0.5;
---

<section class="reviews bg-glass" aria-labelledby="reviews-title">
  <div class="container reviews-grid">
    <div class="summary">
      <h2 id="reviews-title" class="label">From Google reviews</h2>
      <p class="score">
        <span class="num">{googleRating.rating.toFixed(1)}</span>
        <span class="stars" role="img" aria-label={`Rated ${googleRating.rating} out of 5`}>
          {Array.from({ length: fullStars }).map(() => <Icon name="star" />)}
          {hasHalf && <Icon name="starHalf" />}
        </span>
      </p>
      <p class="meta">
        {googleRating.count} reviews on Google as of {googleRating.capturedOnLabel}. Excerpts are quoted as
        written and don’t update automatically.
      </p>
      <p class="topics">
        Mentioned most:
        {googleTopics.map((t, i) => (
          <>
            <span class="topic">{t.label}</span>{i < googleTopics.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
      <a class="text-link" href={business.links.googleReviews} target="_blank" rel="noopener">
        Read every review on Google <Icon name="external" size={16} />
      </a>
    </div>

    <ul role="list" class="quotes">
      {
        reviews.map((r) => (
          <li>
            <figure>
              <blockquote cite={business.links.googleReviews}>
                <p>“{r.quote}”</p>
              </blockquote>
              <figcaption>
                {r.author} · <span class="visually-hidden">{r.stars} out of 5 stars, </span>Google, {r.when}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }

  .reviews-grid {
    display: grid;
    gap: 2.5rem;
  }

  .summary {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    justify-items: start;
  }

  .score {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .num {
    font-family: var(--serif);
    font-size: 4.25rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .meta,
  .topics {
    font-size: 0.92rem;
    color: var(--soft);
    max-width: 24rem;
  }

  .topic {
    color: var(--ink);
    font-weight: 600;
  }

  .quotes {
    display: grid;
    gap: 1.75rem;
  }

  .quotes li + li {
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  blockquote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.7rem);
    line-height: 1.3;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
  }

  @media (min-width: 900px) {
    .reviews-grid {
      grid-template-columns: 1fr 2.3fr;
      gap: 4rem;
    }

    .quotes {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }

    .quotes li + li {
      padding-top: 0;
      padding-left: 2.5rem;
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }
</style>
