---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-white.png';
import Icon from './Icon.astro';
import { business } from '../data/business';

const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <Image src={logo} alt={business.name} width={200} height={95} densities={[1, 2]} />
      </a>
      <p>Seafood and grill on East Grand Avenue, Arroyo Grande.</p>
      <ul role="list" class="social">
        <li>
          <a href={business.links.instagram} target="_blank" rel="noopener me">
            <Icon name="instagram" label="Instagram" />
          </a>
        </li>
        <li>
          <a href={business.links.facebook} target="_blank" rel="noopener me">
            <Icon name="facebook" label="Facebook" />
          </a>
        </li>
        <li>
          <a href={business.links.googleProfile} target="_blank" rel="noopener">
            <Icon name="google" label="Google Maps listing" />
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="footer-title label">Find us</h2>
      <address>
        <a href={business.links.directions} target="_blank" rel="noopener">
          {business.address.street}<br />
          {business.address.city}, {business.address.region} {business.address.postalCode}
        </a>
      </address>
      <p><a href={business.phone.href}>{business.phone.display}</a></p>
    </div>

    <div>
      <h2 class="footer-title label">Hours</h2>
      <dl class="footer-hours">
        {
          business.hoursSummary.map((h) => (
            <div>
              <dt>{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <nav aria-label="Footer">
      <h2 class="footer-title label">Explore</h2>
      <ul role="list" class="footer-links">
        <li><a href="/menu">Menu</a></li>
        <li><a href="/order">Order pickup or delivery</a></li>
        <li><a href="/reservations">Reservations</a></li>
        <li><a href="/visit">Visit &amp; contact</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/photos">Photos</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {business.name}</p>
    <p>Menu and hours can change — call ahead if you’re planning around a dish.</p>
    <p class="credit">
      Website design &amp; maintenance by <a href="https://futuremark.studio" target="_blank" rel="noopener">Future Marketing Studio</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4.5rem 2rem;
    background: var(--navy);
    color: var(--paper);
    font-size: 0.95rem;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }

  .footer-brand p {
    max-width: 20rem;
    margin-top: 1rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.4;
    color: rgb(255 253 249 / 0.82);
  }

  .footer-logo {
    display: inline-block;
  }

  .footer-logo :global(img) {
    width: 9.5rem;
    height: auto;
  }

  .footer-title {
    margin-bottom: 0.9rem;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--blue-light);
    text-decoration: underline;
  }

  address + p {
    margin-top: 0.75rem;
  }

  .footer-hours {
    display: grid;
    gap: 0.6rem;
  }

  .footer-hours dt {
    color: rgb(255 253 249 / 0.72);
  }

  .footer-links {
    display: grid;
    gap: 0.1rem;
  }

  /* Comfortable tap targets (≥ 28px tall) without changing the visual rhythm. */
  .footer-links a,
  .site-footer address a,
  address + p a {
    display: inline-block;
    padding-block: 0.3rem;
  }

  .social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
  }

  .social a:hover {
    border-color: var(--blue-light);
  }

  .social :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.84rem;
    color: rgb(255 253 249 / 0.7);
  }

  .credit {
    flex-basis: 100%;
    font-size: 0.78rem;
    color: rgb(255 253 249 / 0.62);
  }

  .credit a {
    text-decoration: underline;
    text-decoration-color: rgb(255 253 249 / 0.35);
  }

  @media (min-width: 720px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 0.9fr;
    }
  }
</style>
