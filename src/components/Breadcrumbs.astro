---
interface Props {
  trail: { name: string; path: string }[];
}
const { trail } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol role="list">
    {
      trail.map((t, i) => (
        <li>
          {i < trail.length - 1 ? <a href={t.path}>{t.name}</a> : <span aria-current="page">{t.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-size: 0.85rem;
    color: var(--soft);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--line);
  }

  .crumbs a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--blue);
    text-decoration: underline;
    text-decoration-color: rgb(10 102 163 / 0.35);
    text-underline-offset: 0.2em;
  }

  .crumbs [aria-current] {
    padding-block: 0.3rem;
    display: inline-block;
  }
</style>
