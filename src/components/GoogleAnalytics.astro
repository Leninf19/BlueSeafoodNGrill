---
/**
 * Google Analytics 4 (Google tag), included once per page from src/layouts/Base.astro.
 * The Measurement ID lives in src/data/analytics.ts.
 *
 * The CSP in astro.config.mjs allows the Google tag hosts (script-src, img-src, connect-src).
 * The config snippet below is a bundled script, so Astro adds its hash to the CSP automatically.
 *
 * gtag.js (~170 KB) is added after the page's load event so it stays off the critical path for real
 * visitors. Measured 2026-09-25: real-browser LCP ~0.4 s with or without it; Lighthouse's simulated
 * mobile score is still ~8 points lower with the tag (77–78 vs 86 with it blocked) — a lab effect.
 * Page views and clicks queue in dataLayer until it arrives; a visit that leaves before the page
 * finishes loading is not counted.
 *
 * Click events (intent, not outcomes — a tap on "Call" is not a completed call, and an
 * "order_click" is not an order):
 *   phone_click        tel: links
 *   directions_click   Google Maps directions / Apple Maps links
 *   order_click        DoorDash and order.online links
 *   reservation_click  Reserve with Google links
 * Parameters: cta_location (header, mobile_menu, mobile_action_bar, footer, specials_popup,
 * or the page section), link_url, link_text, plus order_platform / map_provider /
 * reservation_platform where relevant.
 */
---

<script>
  import { GA_MEASUREMENT_ID } from '../data/analytics';

  window.dataLayer = window.dataLayer || [];
  window.gtag = function gtag() {
    // gtag.js expects the arguments object itself, not an array.
    window.dataLayer.push(arguments);
  };
  window.gtag('js', new Date());
  window.gtag('config', GA_MEASUREMENT_ID);

  function loadGtag() {
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(script);
  }
  if (document.readyState === 'complete') loadGtag();
  else window.addEventListener('load', loadGtag, { once: true });

  type ClickEvent = [name: string, params: Record<string, string>];

  function eventFor(link: HTMLAnchorElement): ClickEvent | null {
    if ((link.getAttribute('href') ?? '').startsWith('tel:')) return ['phone_click', {}];
    let url: URL;
    try {
      url = new URL(link.href);
    } catch {
      return null;
    }
    const host = url.hostname;
    if (host === 'order.online') return ['order_click', { order_platform: 'order_online' }];
    if (host === 'doordash.com' || host.endsWith('.doordash.com')) return ['order_click', { order_platform: 'doordash' }];
    if (host === 'www.google.com' && url.pathname.startsWith('/maps/reserve'))
      return ['reservation_click', { reservation_platform: 'reserve_with_google' }];
    if (host === 'www.google.com' && url.pathname.startsWith('/maps/dir')) return ['directions_click', { map_provider: 'google_maps' }];
    if (host === 'maps.apple.com') return ['directions_click', { map_provider: 'apple_maps' }];
    return null;
  }

  function locationOf(link: HTMLAnchorElement): string {
    if (link.closest('dialog')) return 'specials_popup';
    if (link.closest('.mobile-actions')) return 'mobile_action_bar';
    if (link.closest('.nav-panel-extra')) return 'mobile_menu';
    if (link.closest('header')) return 'header';
    if (link.closest('footer')) return 'footer';
    const section = link.closest('section');
    return section?.getAttribute('aria-labelledby') || section?.getAttribute('aria-label')?.toLowerCase().replace(/\W+/g, '_') || 'main';
  }

  function track(e: MouseEvent) {
    if (e.type === 'auxclick' && e.button !== 1) return;
    const link = e.target instanceof Element ? e.target.closest('a[href]') : null;
    if (!(link instanceof HTMLAnchorElement)) return;
    const match = eventFor(link);
    if (!match) return;
    window.gtag('event', match[0], {
      ...match[1],
      cta_location: locationOf(link),
      link_url: link.href,
      link_text: (link.textContent ?? '').replace(/\s+/g, ' ').trim().slice(0, 100),
    });
  }

  // Keyboard activation (Enter) also fires "click"; middle-click opens a tab via "auxclick".
  document.addEventListener('click', track);
  document.addEventListener('auxclick', track);
</script>
