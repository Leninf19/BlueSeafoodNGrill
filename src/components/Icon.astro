---
/**
 * Inline SVG icons (no icon font or third-party script).
 * Decorative by default; pass `label` to expose the icon to assistive technology.
 */
interface Props {
  name: keyof typeof icons;
  label?: string;
  class?: string;
  size?: number | string;
}

const icons = {
