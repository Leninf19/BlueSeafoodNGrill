  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  menu: '<path d="M6 3.5h9.5L19 7v13.5H6z"/><path d="M9 9.5h6.5M9 13h6.5M9 16.5h4"/>',
  directions: '<path d="M12 2.8 21.2 12 12 21.2 2.8 12z"/><path d="M9.5 14v-2.5a1.5 1.5 0 0 1 1.5-1.5h4m-2-2 2 2-2 2"/>',
  arrowRight: '<path d="M4.5 12h15m-5.5-6 6 6-6 6"/>',
  external: '<path d="M14 4.5h5.5V10M19.5 4.5 11 13M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/>',
  facebook:
    '<path d="M14 21v-7.5h2.6l.4-3H14V8.7c0-.9.3-1.5 1.6-1.5H17V4.6a19 19 0 0 0-2.3-.1c-2.3 0-3.8 1.4-3.8 3.9v2.1H8.3v3h2.6V21"/>',
  google:
    '<path fill="currentColor" stroke="none" d="M20.6 12.2c0-.6-.1-1.2-.2-1.8H12v3.4h4.8a4.1 4.1 0 0 1-1.8 2.7v2.2h2.9c1.7-1.6 2.7-3.9 2.7-6.5Z"/><path fill="currentColor" stroke="none" d="M12 21c2.4 0 4.5-.8 5.9-2.2L15 16.5c-.8.5-1.8.9-3 .9-2.3 0-4.3-1.6-5-3.7H4v2.3A9 9 0 0 0 12 21Z"/><path fill="currentColor" stroke="none" d="M7 13.7a5.4 5.4 0 0 1 0-3.4V8H4a9 9 0 0 0 0 8.1l3-2.4Z"/><path fill="currentColor" stroke="none" d="M12 6.6c1.3 0 2.5.5 3.4 1.3L18 5.4A9 9 0 0 0 4 8l3 2.3c.7-2.1 2.7-3.7 5-3.7Z"/>',
  star: '<path fill="currentColor" stroke="none" d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z"/>',
  starHalf:
    '<defs><linearGradient id="half-star"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity=".25"/></linearGradient></defs><path fill="url(#half-star)" stroke="none" d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z"/>',
  bag: '<path d="M5.5 8h13l-1 12.5h-11z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  burger: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  flame:
    '<path d="M12 21.5c-4 0-6.8-2.7-6.8-6.5 0-3.3 2.1-5.5 3.7-7.6.5 1.7 1.3 2.9 2.4 3.6-.2-3.2 1-6 3.2-8.5.3 3.5 2.7 5.6 3.8 8.2.5 1.2.7 2.4.7 3.6 0 4.2-3 7.2-7 7.2Z"/><path d="M12 21.5c-1.8 0-3-1.3-3-3 0-1.8 1.4-3 2.2-4.4.8 1.5 3.8 2.3 3.8 4.4 0 1.7-1.2 3-3 3Z"/>',
  utensils: '<path d="M7 3v7.5M4.5 3v5a2.5 2.5 0 0 0 5 0V3M7 10.5V21M17 21V3c-2.2 1.2-3.5 3.6-3.5 6.5V14H17"/>',
} as const;

const { name, label, class: className, size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
